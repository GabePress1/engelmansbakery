{
  "name": "Phase 3 – BC Payments → Excel Log",
  "nodes": [
    {
      "id": "p3-0001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 7 * * 1-5" }]
        }
      }
    },
    {
      "id": "p3-0002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [220, 300],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "cfg-1", "name": "EXCEL_WORKBOOK_ID", "value": "PASTE_YOUR_WORKBOOK_ID_HERE", "type": "string" },
            { "id": "cfg-2", "name": "BC_BASE_URL",        "value": "PASTE_YOUR_BC_API_BASE_URL_HERE", "type": "string" },
            { "id": "cfg-3", "name": "BC_COMPANY_ID",      "value": "PASTE_YOUR_BC_COMPANY_GUID_HERE", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "p3-0003",
      "name": "Read Sync Log",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [440, 300],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "getRows",
        "workbook":  { "__rl": true, "value": "={{ $('Config').first().json.EXCEL_WORKBOOK_ID }}", "mode": "id" },
        "worksheet": { "__rl": true, "value": "sync_log", "mode": "name" },
        "returnAll": true,
        "options": { "dataStartRow": 2 }
      }
    },
    {
      "id": "p3-0004",
      "name": "Set Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300],
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst phase3 = rows\n  .filter(r => r.json.phase === 'phase3')\n  .sort((a, b) => new Date(b.json.run_date) - new Date(a.json.run_date));\nconst lastTimestamp = phase3.length > 0 ? phase3[0].json.last_bc_timestamp : '2000-01-01T00:00:00Z';\nreturn [{ json: { lastTimestamp, runDate: new Date().toISOString() } }];"
      }
    },
    {
      "id": "p3-0005",
      "name": "Fetch Changed BC Payments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [880, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.BC_BASE_URL }}/companies({{ $('Config').first().json.BC_COMPANY_ID }})/customerPayments",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/json" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$filter",
              "value": "={{ `lastModifiedDateTime gt ${$('Set Window').first().json.lastTimestamp}` }}"
            },
            {
              "name": "$select",
              "value": "id,documentNumber,customerNumber,postingDate,amount,appliesToInvoiceId,description,lastModifiedDateTime"
            },
            { "name": "$top", "value": "500" }
          ]
        }
      }
    },
    {
      "id": "p3-0006",
      "name": "Expand Payments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300],
      "parameters": {
        "jsCode": "const payments = $input.first().json.value || [];\nreturn payments.map(p => ({ json: p }));"
      }
    },
    {
      "id": "p3-0007",
      "name": "Loop Over Payments",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1320, 300],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "p3-0008",
      "name": "Upsert Payment Row",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [1540, 200],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "appendOrUpdate",
        "workbook":  { "__rl": true, "value": "={{ $('Config').first().json.EXCEL_WORKBOOK_ID }}", "mode": "id" },
        "worksheet": { "__rl": true, "value": "Payments", "mode": "name" },
        "keyRow": 1,
        "dataStartRow": 2,
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "payment_number":    "={{ $json.documentNumber }}",
            "customer_number":   "={{ $json.customerNumber }}",
            "amount":            "={{ $json.amount }}",
            "payment_date":      "={{ $json.postingDate }}",
            "applied_to_invoice":"={{ $json.appliesToInvoiceId }}",
            "description":       "={{ $json.description }}",
            "last_synced":       "={{ $('Set Window').first().json.runDate }}"
          }
        }
      }
    },
    {
      "id": "p3-0009",
      "name": "Write Sync Log",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [1320, 460],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "append",
        "workbook":  { "__rl": true, "value": "={{ $('Config').first().json.EXCEL_WORKBOOK_ID }}", "mode": "id" },
        "worksheet": { "__rl": true, "value": "sync_log", "mode": "name" },
        "keyRow": 1,
        "dataStartRow": 2,
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_date":          "={{ $('Set Window').first().json.runDate }}",
            "phase":             "phase3",
            "records_processed": "={{ $('Expand Payments').all().length }}",
            "last_bc_timestamp": "={{ $('Set Window').first().json.runDate }}"
          }
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger":        { "main": [[{ "node": "Config",                    "type": "main", "index": 0 }]] },
    "Config":                  { "main": [[{ "node": "Read Sync Log",             "type": "main", "index": 0 }]] },
    "Read Sync Log":           { "main": [[{ "node": "Set Window",                "type": "main", "index": 0 }]] },
    "Set Window":              { "main": [[{ "node": "Fetch Changed BC Payments", "type": "main", "index": 0 }]] },
    "Fetch Changed BC Payments": { "main": [[{ "node": "Expand Payments",         "type": "main", "index": 0 }]] },
    "Expand Payments":         { "main": [[{ "node": "Loop Over Payments",        "type": "main", "index": 0 }]] },
    "Loop Over Payments": {
      "main": [
        [{ "node": "Upsert Payment Row", "type": "main", "index": 0 }],
        [{ "node": "Write Sync Log",     "type": "main", "index": 0 }]
      ]
    },
    "Upsert Payment Row": { "main": [[{ "node": "Loop Over Payments", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
