    {
      "id": "68dbc176-293c-4abd-b3c0-c764429847df",
      "name": "Fetch Invoices for Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        896,
        0
      ],
      "parameters": {
        "url": "=https://api.businesscentral.dynamics.com/v2.0/{{ $('Keys').first().json.Tenant_ID }}/production/api/v2.0/companies({{ $('Keys').first().json.Company_ID }})/salesInvoices",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$filter",
              "value": "={{ `customerNumber eq '${$('Customer ERP').first().json.erp_number}'` }}"
            },
            {
              "name": "$select",
              "value": "id,number,customerNumber,customerName,invoiceDate,dueDate,shipmentDate,totalAmountIncludingTax,status,lastModifiedDateTime"
            },
            {
              "name": "$orderby",
              "value": "invoiceDate asc"
            },
            {
              "name": "$top",
              "value": "500"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get BC Token').first().json.access_token }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f99b2076-1149-4fca-af03-6fea569580c6",
      "name": "Expand Invoices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "jsCode": "const invoices = $input.first().json.value || [];\nif (invoices.length === 0) return [{ json: { message: 'No invoices found', erp: $('Customer ERP').first().json.erp_number } }];\nreturn invoices.map(i => ({ json: i }));"
      }
    }
  ],
