{
  "name": "BC to HubSpot",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "notes": "Fires at 8:00 AM Monday–Friday"
    },
    {
      "parameters": {
        "url": "={{ $env.BC_API_BASE_URL }}/v2/catalog/products",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Get BC Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bc-api-credentials",
          "name": "BigCommerce API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst products = items[0].json.data || [];\n\nreturn products.map(product => ({\n  json: {\n    name: product.name,\n    sku: product.sku,\n    price: product.price,\n    inventory_level: product.inventory_level,\n    is_visible: product.is_visible,\n    bc_product_id: product.id,\n    categories: product.categories,\n    brand_id: product.brand_id,\n    updated_at: product.date_modified\n  }\n}));"
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Transform BC Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "search",
        "filterGroups": {
          "filterGroupsUi": {
            "filterGroupValues": [
              {
                "filtersUi": {
                  "filterValues": [
                    {
                      "propertyName": "bc_product_id",
                      "operator": "EQ",
                      "value": "={{ $json.bc_product_id }}"
                    }
                  ]
                }
              }
            ]
          }
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Search HubSpot Record",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [900, 300],
      "credentials": {
        "hubspotApi": {
          "id": "hubspot-credentials",
          "name": "HubSpot API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-exists",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Record Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "resource": "product",
        "operation": "update",
        "productId": "={{ $json.results[0].id }}",
        "updateFields": {
          "name": "={{ $('Transform BC Data').item.json.name }}",
          "price": "={{ $('Transform BC Data').item.json.price }}",
          "sku": "={{ $('Transform BC Data').item.json.sku }}",
          "customProperties": {
            "property": [
              {
                "name": "bc_product_id",
                "value": "={{ $('Transform BC Data').item.json.bc_product_id }}"
              },
              {
                "name": "inventory_level",
                "value": "={{ $('Transform BC Data').item.json.inventory_level }}"
              },
              {
                "name": "bc_last_synced",
                "value": "={{ new Date().toISOString() }}"
              }
            ]
          }
        }
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Update HubSpot Product",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [1340, 200],
      "credentials": {
        "hubspotApi": {
          "id": "hubspot-credentials",
          "name": "HubSpot API"
        }
      }
    },
    {
      "parameters": {
        "resource": "product",
        "operation": "create",
        "name": "={{ $('Transform BC Data').item.json.name }}",
        "additionalFields": {
          "price": "={{ $('Transform BC Data').item.json.price }}",
          "sku": "={{ $('Transform BC Data').item.json.sku }}",
          "customProperties": {
            "property": [
              {
                "name": "bc_product_id",
                "value": "={{ $('Transform BC Data').item.json.bc_product_id }}"
              },
              {
                "name": "inventory_level",
                "value": "={{ $('Transform BC Data').item.json.inventory_level }}"
              },
              {
                "name": "bc_last_synced",
                "value": "={{ new Date().toISOString() }}"
              }
            ]
          }
        }
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Create HubSpot Product",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [1340, 400],
      "credentials": {
        "hubspotApi": {
          "id": "hubspot-credentials",
          "name": "HubSpot API"
        }
      }
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_CHANNEL_ID }}",
        "text": "=*BC to HubSpot Sync Complete*\nDate: {{ new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) }}\nRecords processed: {{ $('Transform BC Data').all().length }}"
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Notify on Completion",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1560, 300],
      "credentials": {
        "slackApi": {
          "id": "slack-credentials",
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get BC Products",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get BC Products": {
      "main": [
        [
          {
            "node": "Transform BC Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform BC Data": {
      "main": [
        [
          {
            "node": "Search HubSpot Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search HubSpot Record": {
      "main": [
        [
          {
            "node": "Record Exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Exists?": {
      "main": [
        [
          {
            "node": "Update HubSpot Product",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create HubSpot Product",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update HubSpot Product": {
      "main": [
        [
          {
            "node": "Notify on Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create HubSpot Product": {
      "main": [
        [
          {
            "node": "Notify on Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [
    {
      "name": "bigcommerce"
    },
    {
      "name": "hubspot"
    },
    {
      "name": "sync"
    }
  ],
  "triggerCount": 0,
  "updatedAt": "2026-05-15T00:00:00.000Z",
  "versionId": "1"
}
