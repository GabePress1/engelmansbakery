        "jsCode": "const store = $getWorkflowStaticData('global');\nconst payload = {\n  filterGroups: [{ filters: [\n    { propertyName: 'relationship',        operator: 'EQ',             value: 'Customer' },\n    { propertyName: 'division_multiselect', operator: 'CONTAINS_TOKEN', value: \"Engelman's Bakery\" },\n    { propertyName: 'erp_account_number',  operator: 'HAS_PROPERTY' }\n  ]}],\n  properties: ['hs_object_id', 'erp_account_number', 'name', 'ordering_status', 'first_invoice_date'],\n  limit: 200\n};\nif (store.hsCursor) payload.after = store.hsCursor;\nreturn [{ json: payload }];"
