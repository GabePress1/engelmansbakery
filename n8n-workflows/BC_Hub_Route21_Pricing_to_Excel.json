        }
      },
      "id": "a1000000-0000-0000-0000-000000000051",
      "name": "Clear SalesOrders Sheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1540, 660],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst token = store.graphToken;\nconst driveId = store.driveId;\nconst fileId = store.fileItemId;\n\nconst soRows = $('Build Sales Order Rows').all();\nconst values = soRows.map(r => [\n  r.json['Order No'],\n  r.json['Customer No'],\n  r.json['Customer Name'],\n  r.json['PO Number'],\n  r.json['Status'],\n  r.json['Requested Delivery']\n]);\n\nconst rowCount = values.length;\nconst endRow = rowCount + 1;\nconst addUrl = `https://graph.microsoft.com/v1.0/drives/${driveId}/items/${fileId}/workbook/worksheets('OpenSalesOrders')/range(address='OpenSalesOrders!A2:F${endRow}')`;\n\nreturn [{ json: { addUrl, token, values } }];"
      },
      "id": "a1000000-0000-0000-0000-000000000052",
      "name": "Prepare SO Write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 660]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $json.addUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
