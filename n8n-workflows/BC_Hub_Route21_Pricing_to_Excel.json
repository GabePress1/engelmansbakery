      "id": "a1000000-0000-0000-0000-000000000012",
      "name": "Fetch Open Sales Orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [760, 780]
    },
    {
      "parameters": {
        "jsCode": "const lines = $('Fetch All Invoice Lines (YTD)').first().json.value || [];\nconst headers = $('Fetch All Invoice Headers (YTD)').first().json.value || [];\n\nconst headerMap = {};\nfor (const h of headers) {\n  headerMap[h.No] = {\n    poNumber: h.External_Document_No || '',\n    requestedDelivery: h.Requested_Delivery_Date_SOD || '',\n    postingDate: h.Posting_Date || '',\n    orderNo: h.Order_No || ''\n  };\n}\n\nconst rows = lines.map(l => {\n  const hdr = headerMap[l.Document_No] || {};\n  return {\n    json: {\n      'Item No': l.No || '',\n      'Description': l.Description || '',\n      'Invoice No': l.Document_No || '',\n      'Customer No': l.Sell_to_Customer_No || '',\n      'Customer Name': l.Sell_to_Customer_Name || '',\n      'Quantity': Number(l.Quantity || 0),\n      'Unit Price': Number(l.Unit_Price || 0),\n      'Amount': Number(l.Amount || 0),\n      'Sales Order No': l.Order_No || hdr.orderNo || '',\n      'PO Number': hdr.poNumber || '',\n      'Posting Date': l.ERC_Posting_Date || hdr.postingDate || '',\n      'Requested Delivery': hdr.requestedDelivery || ''\n    }\n  };\n});\n\nreturn rows.length > 0 ? rows : [{ json: { 'Item No': '', 'Description': 'No data', 'Invoice No': '', 'Customer No': '', 'Customer Name': '', 'Quantity': 0, 'Unit Price': 0, 'Amount': 0, 'Sales Order No': '', 'PO Number': '', 'Posting Date': '', 'Requested Delivery': '' } }];"
      },
      "id": "a1000000-0000-0000-0000-000000000020",
      "name": "Build Invoice Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 440]
    },
    {
      "parameters": {
        "jsCode": "const orders = $('Fetch Open Sales Orders').first().json.value || [];\n\nconst rows = orders.map(o => ({\n  json: {\n    'Order No': o.No || '',\n    'Customer No': o.Sell_to_Customer_No || '',\n    'Customer Name': o.Sell_to_Customer_Name || '',\n    'PO Number': o.External_Document_No || '',\n    'Status': o.Status || '',\n    'Requested Delivery': o.Requested_Delivery_Date || ''\n  }\n}));\n\nreturn rows.length > 0 ? rows : [{ json: { 'Order No': '', 'Customer No': '', 'Customer Name': '', 'PO Number': '', 'Status': 'No open orders', 'Requested Delivery': '' } }];"
      },
      "id": "a1000000-0000-0000-0000-000000000021",
      "name": "Build Sales Order Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 720]
    },
    {
      "parameters": {
        "jsCode": "// ── CONFIG ──────────────────────────────────────────────────\n// Set these to match your SharePoint site and file path\nconst SHAREPOINT_SITE_ID   = 'YOUR_SHAREPOINT_SITE_ID';       // e.g. 'contoso.sharepoint.com,guid1,guid2'\nconst DRIVE_ID             = 'YOUR_DRIVE_ID';                  // document library drive ID\nconst EXCEL_FILE_ITEM_ID   = 'YOUR_EXCEL_FILE_ITEM_ID';        // the .xlsx file's item ID\n// ────────────────────────────────────────────────────────────\n\nconst graphToken = $('Get Graph Token').first().json.access_token;\n\nconst store = $getWorkflowStaticData('global');\nstore.graphToken = graphToken;\nstore.siteId = SHAREPOINT_SITE_ID;\nstore.driveId = DRIVE_ID;\nstore.fileItemId = EXCEL_FILE_ITEM_ID;\n\nreturn [{ json: { ready: true } }];"
      },
      "id": "a1000000-0000-0000-0000-000000000030",
      "name": "Configure SharePoint IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 720]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst token = store.graphToken;\nconst driveId = store.driveId;\nconst fileId = store.fileItemId;\n\nreturn [{ json: {\n  clearUrl: `https://graph.microsoft.com/v1.0/drives/${driveId}/items/${fileId}/workbook/worksheets('InvoiceLines')/range(address='InvoiceLines!A2:L100000')`,\n  token\n} }];"
      },
      "id": "a1000000-0000-0000-0000-000000000040",
      "name": "Prepare Clear InvoiceLines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 340]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $json.clearUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"values\": null }",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1000000-0000-0000-0000-000000000041",
      "name": "Clear InvoiceLines Sheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1540, 340],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst token = store.graphToken;\nconst driveId = store.driveId;\nconst fileId = store.fileItemId;\n\nconst invoiceRows = $('Build Invoice Rows').all();\nconst values = invoiceRows.map(r => [\n  r.json['Item No'],\n  r.json['Description'],\n  r.json['Invoice No'],\n  r.json['Customer No'],\n  r.json['Customer Name'],\n  r.json['Quantity'],\n  r.json['Unit Price'],\n  r.json['Amount'],\n  r.json['Sales Order No'],\n  r.json['PO Number'],\n  r.json['Posting Date'],\n  r.json['Requested Delivery']\n]);\n\nconst rowCount = values.length;\nconst endRow = rowCount + 1;\nconst addUrl = `https://graph.microsoft.com/v1.0/drives/${driveId}/items/${fileId}/workbook/worksheets('InvoiceLines')/range(address='InvoiceLines!A2:L${endRow}')`;\n\nreturn [{ json: { addUrl, token, values } }];"
      },
      "id": "a1000000-0000-0000-0000-000000000042",
      "name": "Prepare Invoice Write",
