    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global').rt21;\nconst orders = $('Fetch Orders').first().json.value || [];\nconst invoices = $('Fetch Invoices').first().json.value || [];\nstore.orders = orders;\nstore.invoices = invoices;\nconst chunk = (arr, n) => { const out = []; for (let i = 0; i < arr.length; i += n) out.push(arr.slice(i, i + n)); return out; };\nconst esc = s => String(s).replace(/'/g, \"''\");\nconst items = [];\nfor (const c of chunk(orders.map(o => o.No), 80)) {\n  items.push({ json: { kind: 'order', filter: \"Document_Type eq 'Order' and (\" + c.map(n => \"Document_No eq '\" + esc(n) + \"'\").join(' or ') + \")\" } });\n}\nfor (const c of chunk(invoices.map(v => v.No), 80)) {\n  items.push({ json: { kind: 'invoice', filter: \"(\" + c.map(n => \"Document_No eq '\" + esc(n) + \"'\").join(' or ') + \")\" } });\n}\nif (items.length === 0) items.push({ json: { kind: 'noop', filter: \"Document_No eq 'NOOP_NONE'\" } });\nreturn items;"
      },
