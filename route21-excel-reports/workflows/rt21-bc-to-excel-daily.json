    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global').rt21;\nconst kind = $('Loop Chunks').first().json.kind;\nconst rows = $json.value || [];\nif (kind === 'order') store.orderLines.push(...rows);\nif (kind === 'invoice') store.invoiceLines.push(...rows);\nreturn [{ json: { kind, added: rows.length, orderLines: store.orderLines.length, invoiceLines: store.invoiceLines.length } }];"
      },
