    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global').rt21;\nconst init = $('Init').first().json;\nconst fileId = $('Get Working File').first().json.id;\nconst sessionId = $('Create Session').first().json.id;\nstore.fileId = fileId;\nstore.sessionId = sessionId;\nconst colLetter = (n) => { let s = ''; while (n > 0) { const m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); } return s; };\n\n// Build the Combined (pivot-ready) dataset: Item lines only\nconst statusByOrder = {};\nconst reqDateByOrder = {};\nfor (const o of store.orders) { statusByOrder[o.No] = o.Status || 'Open'; reqDateByOrder[o.No] = o.Requested_Delivery_Date || ''; }\nconst custNameByOrder = {};\nfor (const o of store.orders) custNameByOrder[o.No] = o.Sell_to_Customer_Name || '';\nconst postDateByInvoice = {};\nfor (const v of store.invoices) postDateByInvoice[v.No] = v.Posting_Date || '';\nconst combined = [];\nfor (const l of store.orderLines) {\n  if (l.Type !== 'Item') continue;\n  const qty = Number(l.Quantity) || 0;\n  const out = Number(l.Outstanding_Quantity) || 0;\n  const up = qty > 0 ? Math.round(((Number(l.Line_Amount) || 0) / qty) * 10000) / 10000 : '';\n  combined.push({\n    'SO Number': l.Document_No,\n    'Status': statusByOrder[l.Document_No] || 'Open',\n    'Requested_Delivery_Date': reqDateByOrder[l.Document_No] || l.Shipment_Date || '',\n    'No': l.No,\n    'Description': l.Description,\n    'Quantity': out,\n    'Unit Price': up,\n    'Line_Amount': up === '' ? 0 : Math.round(up * out * 100) / 100,\n    'Sell_to_Customer_No': l.Sell_to_Customer_No,\n    'Sell_to_Customer_Name': l.Sell_to_Customer_Name || custNameByOrder[l.Document_No] || ''\n  });\n}\nfor (const l of store.invoiceLines) {\n  if (l.Type !== 'Item') continue;\n  combined.push({\n    'SO Number': l.Order_No || l.Document_No,\n    'Status': 'Invoiced',\n    'Requested_Delivery_Date': postDateByInvoice[l.Document_No] || l.ERC_Posting_Date || '',\n    'No': l.No,\n    'Description': l.Description,\n    'Quantity': Number(l.Quantity) || 0,\n    'Unit Price': l.Unit_Price,\n    'Line_Amount': l.Amount,\n    'Sell_to_Customer_No': l.Sell_to_Customer_No,\n    'Sell_to_Customer_Name': l.Sell_to_Customer_Name\n  });\n}\nstore.combinedCount = combined.length;\n\nconst sheets = [\n  { sheet: 'Sales Orders',  rows: store.orders,       cols: [\"No\", \"Order_Date\", \"Requested_Delivery_Date\", \"Shipment_Date\", \"Status\", \"Sell_to_Customer_No\", \"Sell_to_Customer_Name\", \"Ship_to_Name\", \"Ship_to_City\", \"Shipping_Agent_Code\", \"External_Document_No\", \"Salesperson_Code\", \"Location_Code\", \"Completely_Shipped\"] },\n  { sheet: 'Order Lines',   rows: store.orderLines,   cols: [\"Document_No\", \"Line_No\", \"Type\", \"No\", \"Description\", \"Quantity\", \"Qty_to_Ship\", \"Outstanding_Quantity\", \"Unit_of_Measure_Code\", \"Line_Amount\", \"Shipment_Date\", \"Location_Code\", \"Sell_to_Customer_No\"] },\n  { sheet: 'Invoices',      rows: store.invoices,     cols: [\"No\", \"Posting_Date\", \"Due_Date\", \"Order_No\", \"Sell_to_Customer_No\", \"Sell_to_Customer_Name\", \"Ship_to_Name\", \"Ship_to_City\", \"Shipping_Agent_Code\", \"External_Document_No\", \"Salesperson_Code\", \"Payment_Terms_Code\", \"Location_Code\"] },\n  { sheet: 'Invoice Lines', rows: store.invoiceLines, cols: [\"Document_No\", \"Line_No\", \"Type\", \"No\", \"Description\", \"Quantity\", \"Unit_of_Measure_Code\", \"Unit_Price\", \"Line_Discount_Amount\", \"Amount\", \"Amount_Including_VAT\", \"ERC_Posting_Date\", \"Sell_to_Customer_No\", \"Order_No\"] },\n  { sheet: 'Combined',      rows: combined,           cols: [\"SO Number\", \"Status\", \"Requested_Delivery_Date\", \"No\", \"Description\", \"Quantity\", \"Unit Price\", \"Line_Amount\", \"Sell_to_Customer_No\", \"Sell_to_Customer_Name\"] }\n];\nconst items = [];\nconst CH = 1000;\nfor (const s of sheets) {\n  const width = s.cols.length;\n  const dataRows = s.rows.map(r => s.cols.map(c => { const v = r[c]; return (v === null || v === undefined) ? '' : v; }));\n  const all = [s.cols, ...dataRows];\n  store.sheetRanges[s.sheet] = { address: 'A1:' + colLetter(width) + all.length, rows: dataRows.length };\n  for (let i = 0; i < all.length; i += CH) {\n    const slice = all.slice(i, i + CH);\n    items.push({ json: { sheet: s.sheet, address: 'A' + (i + 1) + ':' + colLetter(width) + (i + slice.length), values: slice, fileId, sessionId, driveId: init.driveId } });\n  }\n}\nreturn items;"
      },
