    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global').rt21;\nconst init = $('Init').first().json;\nconst items = [];\nfor (const [sheet, r] of Object.entries(store.sheetRanges)) {\n  if (r.rows > 0) items.push({ json: { sheet, address: r.address, driveId: init.driveId, fileId: store.fileId, sessionId: store.sessionId } });\n}\nif (items.length === 0) items.push({ json: { sheet: 'Sales Orders', address: 'A1:A1', driveId: init.driveId, fileId: store.fileId, sessionId: store.sessionId } });\nreturn items;"
      },
