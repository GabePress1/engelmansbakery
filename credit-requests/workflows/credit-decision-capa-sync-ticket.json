      "id": "db189cd8-2383-4a4f-bbe5-197575ffc1f9",
      "name": "Webhook - Item Stage Changed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 96],
      "webhookId": "80574754-67d6-4e79-b7a7-932bc8fdccc7"
    },
    {
      "parameters": {
        "jsCode": "const webhookInput = $input.first().json;\nconst body = webhookInput.body || webhookInput;\nconst itemId = body.objectId || body.id;\nconst newStage = body.properties?.hs_pipeline_stage?.value || body.hs_pipeline_stage;\n\nif (!itemId || !newStage) {\n  return [{ json: { error: 'Missing itemId or stage', received: body } }];\n}\n\nreturn [{ json: { itemId, newStage } }];"
      },
      "id": "50ea9424-d8ad-482c-a14e-c7bc7616f771",
      "name": "Extract Item Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 96]
    },
    {
      "parameters": {
        "jsCode": "const newStage = String($json.newStage);\nconst allowedStages = ['1388087301', '1388087302'];\n\nif (!allowedStages.includes(newStage)) {\n  return [];\n}\n\nreturn [{ json: { itemId: $json.itemId, newStage: newStage } }];"
      },
      "id": "3345bd50-f8bb-4650-8f2d-06e80e3998b5",
      "name": "Validate Stage (Credit Decision or CAPA)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 96]
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/2-48651243/{{ $json.itemId }}/associations/tickets",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "4e0fae74-6bec-4242-995e-7a56ed36cf37",
      "name": "Get Associated Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [672, 0],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst results = response.results || [];\n\nif (results.length === 0) {\n  return [{ json: { error: 'No associated ticket found' } }];\n}\n\nconst ticketId = results[0].id;\nreturn [{ json: { ticketId } }];"
      },
      "id": "100a390c-130b-4827-9625-71c6f59a3919",
      "name": "Extract Ticket ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 0]
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/tickets/{{ $json.ticketId }}/associations/2-48651243",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "e810c3dd-aa21-4b33-8cdf-38af2fe7a4b1",
      "name": "Get All Associated Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 0],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/2-48651243/batch/read",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: $json.results.map(a => ({ id: a.id || a.toObjectId })), properties: ['hs_pipeline_stage'] }) }}",
        "options": {}
      },
      "id": "cd-capa-batch-read",
      "name": "Batch Read Item Stages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1344, 0],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.results || [];\n\nif (items.length === 0) {\n  return [{ json: { error: 'No associated items' } }];\n}\n\n// Item pipeline stage order (earliest -> latest)\nconst STAGE_ORDER = {\n  '1386096010': 0, // Verification\n  '1388087301': 1, // Credit Decision\n  '1388087302': 2, // CAPA\n  '1386096011': 3  // Closed\n};\n\nlet lowestStage = null;\nlet lowestRank = Infinity;\nconst stages = [];\n\nfor (const item of items) {\n  const stage = String(item.properties.hs_pipeline_stage);\n  stages.push(stage);\n  const rank = STAGE_ORDER[stage];\n  if (rank !== undefined && rank < lowestRank) {\n    lowestRank = rank;\n    lowestStage = stage;\n  }\n}\n\nif (lowestStage === null) {\n  return [{ json: { error: 'No recognized item stages', stages } }];\n}\n\nreturn [{ json: { itemStage: lowestStage, allStages: stages, itemCount: items.length, success: true } }];"
      },
      "id": "2175c935-457a-4ef4-8114-6bd6bda80ee7",
      "name": "Get Item Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1568, 0]
    },
    {
      "parameters": {
        "jsCode": "const itemStage = $json.itemStage;\nconst stageMapping = {\n  '1386096010': '1385996039', // Verification\n  '1388087301': '1387983013', // Credit Decision\n  '1388087302': '1387983014', // CAPA\n  '1386096011': '1385996040'  // Closed\n};\n\nconst ticketStage = stageMapping[itemStage];\n\nif (!ticketStage) {\n  return [{ json: { error: 'No ticket stage mapping for item stage: ' + itemStage } }];\n}\n\nreturn [{ json: { ticketStage: ticketStage, itemStage: itemStage } }];"
      },
      "id": "db993a4c-484b-4477-9bd9-122164471e9c",
      "name": "Map Item Stage to Ticket Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1792, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/tickets/{{ $('Extract Ticket ID').first().json.ticketId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
