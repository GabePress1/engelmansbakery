      "parameters": {
        "jsCode": "const webhookInput = $input.first().json;\nconst body = webhookInput.body || webhookInput;\nconst ticketId = body.objectId || body.id;\n\nif (!ticketId) {\n  return [{ json: { error: 'Missing ticketId', received: body } }];\n}\n\nreturn [{ json: { ticketId: String(ticketId) } }];"
