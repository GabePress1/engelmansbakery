{
  "name": "Credit Given Guard - Sync Ticket to CAPA",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "credit-given-check",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "cg-webhook",
      "name": "Webhook - Credit Given Changed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "credit-given-check"
    },
    {
      "parameters": {
        "jsCode": "const webhookInput = $input.first().json;\nconst body = webhookInput.body || webhookInput;\nconst ticketId = body.objectId || body.id;\n\nif (!ticketId) {\n  return [{ json: { error: 'Missing ticketId', received: body } }];\n}\n\nreturn [{ json: { ticketId: String(ticketId) } }];"
      },
      "id": "cg-extract",
      "name": "Extract Ticket Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/tickets/{{ $json.ticketId }}/associations/2-48651243",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "cg-get-items",
      "name": "Get Associated Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [440, 0],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const associations = $input.first().json.results || [];\nconst ticketId = $('Extract Ticket Info').first().json.ticketId;\n\nif (associations.length === 0) {\n  return [{ json: { ticketId, decision: 'none', reason: 'No associated items' } }];\n}\n\nconst itemIds = associations.map(a => a.id || a.toObjectId);\n\nconst batchBody = { inputs: itemIds.map(id => ({ id })), properties: ['hs_pipeline_stage'] };\n\nconst response = await this.helpers.httpRequestWithAuthentication.call(this, 'hubspotAppToken', {\n  method: 'POST',\n  url: 'https://api.hubapi.com/crm/v3/objects/2-48651243/batch/read',\n  body: batchBody,\n  json: true,\n  headers: { 'Content-Type': 'application/json' }\n});\n\nconst items = response.results || [];\n\nconst ITEM_VERIFICATION = '1386096010';\nconst ITEM_CREDIT_DECISION = '1388087301';\nconst ITEM_CAPA = '1388087302';\nconst ITEM_CLOSED = '1386096011';\n\nlet allReady = true;   // every item in CAPA or Closed\nlet hasEarly = false;  // any item still in Verification or Credit Decision\nconst stages = [];\n\nfor (const item of items) {\n  const stage = String(item.properties.hs_pipeline_stage);\n  stages.push(stage);\n  const isReady = (stage === ITEM_CAPA || stage === ITEM_CLOSED);\n  if (!isReady) {\n    allReady = false;\n  }\n  if (stage === ITEM_VERIFICATION || stage === ITEM_CREDIT_DECISION) {\n    hasEarly = true;\n  }\n}\n\nlet decision;\nif (allReady) {\n  decision = 'advance';\n} else if (hasEarly) {\n  decision = 'revert';\n} else {\n  decision = 'none';\n}\n\nreturn [{ json: { ticketId, decision, allReady, hasEarly, itemCount: items.length, stages } }];"
      },
      "id": "cg-evaluate",
      "name": "Evaluate Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "id": "cond-advance",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "advance",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "cg-if-advance",
      "name": "All Items Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/tickets/{{ $json.ticketId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { hs_pipeline_stage: '1387983014' } }) }}",
        "options": {}
      },
      "id": "cg-advance",
      "name": "Move Ticket to CAPA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1100, -120],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, action: 'advanced', message: 'All items in CAPA or Closed - ticket moved to CAPA', ticketStage: 'CAPA' }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" }
            ]
          }
        }
      },
      "id": "cg-advance-response",
      "name": "Advance Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, -120]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "id": "cond-revert",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "revert",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
