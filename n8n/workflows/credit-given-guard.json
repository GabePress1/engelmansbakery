    {
      "parameters": {
        "jsCode": "const items = $input.first().json.results || [];\nconst ticketId = $('Extract Ticket Info').first().json.ticketId;\n\nconst ITEM_VERIFICATION = '1386096010';\nconst ITEM_CREDIT_DECISION = '1388087301';\nconst ITEM_CAPA = '1388087302';\nconst ITEM_CLOSED = '1386096011';\n\nlet allReady = true;\nlet hasEarly = false;\nconst stages = [];\n\nfor (const item of items) {\n  const stage = String(item.properties.hs_pipeline_stage);\n  stages.push(stage);\n  if (stage !== ITEM_CAPA && stage !== ITEM_CLOSED) {\n    allReady = false;\n  }\n  if (stage === ITEM_VERIFICATION || stage === ITEM_CREDIT_DECISION) {\n    hasEarly = true;\n  }\n}\n\nlet decision;\nif (items.length === 0) {\n  decision = 'none';\n} else if (allReady) {\n  decision = 'advance';\n} else if (hasEarly) {\n  decision = 'revert';\n} else {\n  decision = 'none';\n}\n\n// Build the decision HTML: credited / not credited / complaints\n// NOTE: the item property labeled \"Credit Approved\" has internal name credit_given\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst isYes = v => ['true', 'yes', 'y', '1'].includes(String(v || '').toLowerCase());\nconst credited = [];\nconst notCredited = [];\nconst complaints = [];\nfor (const item of items) {\n  const p = item.properties;\n  let label = '<strong>' + esc(p.item_no_ || p.item_name || item.id) + '</strong>';\n  if (p.item_description) label += ' — ' + esc(p.item_description);\n  if (p.quantity) label += ' × ' + esc(p.quantity);\n  const amt = parseFloat(p.approved_credit_amount);\n  if (String(p.request_type || '').toLowerCase() === 'complaint') {\n    complaints.push('<li>' + label + '</li>');\n  } else if (isYes(p.credit_given) || (!isNaN(amt) && amt > 0)) {\n    credited.push('<li>' + label + (!isNaN(amt) && amt > 0 ? ' — Credit: $' + amt.toFixed(2) : '') + '</li>');\n  } else {\n    notCredited.push('<li>' + label + '</li>');\n  }\n}\nlet decisionHtml =\n  '<p><strong>Items credited:</strong></p>' +\n  (credited.length ? '<ul>' + credited.join('') + '</ul>' : '<p>None</p>') +\n  '<p><strong>Items not credited:</strong></p>' +\n  (notCredited.length ? '<ul>' + notCredited.join('') + '</ul>' : '<p>None</p>');\nif (complaints.length) {\n  decisionHtml += '<p><strong>Complaint items (handled by our quality team, no credit requested):</strong></p><ul>' + complaints.join('') + '</ul>';\n}\n\nreturn [{ json: { ticketId, decision, allReady, hasEarly, itemCount: items.length, stages, decisionHtml } }];"
      },
