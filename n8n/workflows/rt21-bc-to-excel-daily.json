      "id": "rt21-resolve",
      "name": "Resolve File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2688,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global').rt21;\nconst sheets = store.sheets; const old = store.old || {};\nconst colLetter = (n) => { let s=''; while(n>0){const m=(n-1)%26; s=String.fromCharCode(65+m)+s; n=Math.floor((n-1)/26);} return s; };\nconst driveId = store.__drive || $('Init').first().json.driveId;\nconst fileId = store.fileId; const sessionId = store.sessionId;\nconst CH=1000, ADDCH=500; const ops=[];\nfor (const s of sheets){\n  const width=s.cols.length; const col=colLetter(width);\n  const dataRows=s.rows.map(r=>s.cols.map(c=>{const v=r[c]; return (v===null||v===undefined)?'':v;}));\n  const all=[s.cols, ...dataRows]; const newN=dataRows.length;\n  const oldN=(s.sheet in old)?old[s.sheet]:-1;\n  ops.push({ op:'ensureSheet', sheet:s.sheet, driveId, fileId, sessionId });\n  if (oldN<0){\n    for (let i=0;i<all.length;i+=CH){ const sl=all.slice(i,i+CH); ops.push({ op:'write', sheet:s.sheet, address:'A'+(i+1)+':'+col+(i+sl.length), values:sl, driveId, fileId, sessionId }); }\n    ops.push({ op:'createTable', sheet:s.sheet, address:'A1:'+col+(Math.max(newN,1)+1), tableName:s.table, driveId, fileId, sessionId });\n  } else {\n    if (newN>oldN){ let toAdd=newN-oldN; const er=new Array(width).fill(''); while(toAdd>0){ const c=Math.min(toAdd,ADDCH); ops.push({ op:'addRows', table:s.table, values:Array.from({length:c},()=>er.slice()), driveId, fileId, sessionId }); toAdd-=c; } }\n    else if (newN<oldN){ ops.push({ op:'deleteRange', sheet:s.sheet, address:'A'+(newN+2)+':'+col+(oldN+1), driveId, fileId, sessionId }); }\n    for (let i=0;i<all.length;i+=CH){ const sl=all.slice(i,i+CH); ops.push({ op:'write', sheet:s.sheet, address:'A'+(i+1)+':'+col+(i+sl.length), values:sl, driveId, fileId, sessionId }); }\n  }\n}\nreturn ops.map(o=>({json:o}));"
      },
