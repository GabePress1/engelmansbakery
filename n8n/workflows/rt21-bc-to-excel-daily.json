    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global').rt21;\nconst init = $('Init').first().json;\nconst fileId = $('Resolve File').first().json.fileId;\nconst sessionId = $('Create Session').first().json.id;\nconst driveId = init.driveId;\nstore.fileId = fileId; store.sessionId = sessionId;\nconst statusByOrder={}, reqDateByOrder={}, custNameByOrder={};\nfor (const o of store.orders){ statusByOrder[o.No]=o.Status||'Open'; reqDateByOrder[o.No]=o.Requested_Delivery_Date||''; custNameByOrder[o.No]=o.Sell_to_Customer_Name||''; }\nconst postDateByInvoice={}, custNameByInvoice={};\nfor (const v of store.invoices){ postDateByInvoice[v.No]=v.Requested_Delivery_Date_SOD||v.Posting_Date||''; custNameByInvoice[v.No]=v.Sell_to_Customer_Name||''; }\nconst combined=[];\nfor (const l of store.orderLines){ if(l.Type!=='Item') continue; const qty=Number(l.Quantity)||0; const out=Number(l.Outstanding_Quantity)||0; const up=qty>0?Math.round(((Number(l.Line_Amount)||0)/qty)*10000)/10000:''; combined.push({ 'SO Number':l.Document_No, 'Status':statusByOrder[l.Document_No]||'Open', 'Requested_Delivery_Date':reqDateByOrder[l.Document_No]||l.Shipment_Date||'', 'No':l.No, 'Description':l.Description, 'Quantity':out, 'Unit Price':up, 'Line_Amount': up===''?0:Math.round(up*out*100)/100, 'Sell_to_Customer_No':l.Sell_to_Customer_No, 'Sell_to_Customer_Name':l.Sell_to_Customer_Name||custNameByOrder[l.Document_No]||'' }); }\nfor (const l of store.invoiceLines){ if(l.Type!=='Item') continue; combined.push({ 'SO Number':l.Order_No||l.Document_No, 'Status':'Invoiced', 'Requested_Delivery_Date':postDateByInvoice[l.Document_No]||l.ERC_Posting_Date||'', 'No':l.No, 'Description':l.Description, 'Quantity':Number(l.Quantity)||0, 'Unit Price':l.Unit_Price, 'Line_Amount':l.Amount, 'Sell_to_Customer_No':l.Sell_to_Customer_No, 'Sell_to_Customer_Name':l.Sell_to_Customer_Name||custNameByInvoice[l.Document_No]||'' }); }\nstore.combinedCount = combined.length;\n\nconst sheets = [\n  { sheet:'Sales Orders',  table:'Table1',   rows:store.orders,       cols:[\"No\", \"Order_Date\", \"Requested_Delivery_Date\", \"Shipment_Date\", \"Status\", \"Sell_to_Customer_No\", \"Sell_to_Customer_Name\", \"Ship_to_Name\", \"Ship_to_City\", \"Shipping_Agent_Code\", \"External_Document_No\", \"Salesperson_Code\", \"Location_Code\", \"Completely_Shipped\"] },\n  { sheet:'Order Lines',   table:'Table2',   rows:store.orderLines,   cols:[\"Document_No\", \"Line_No\", \"Type\", \"No\", \"Description\", \"Quantity\", \"Qty_to_Ship\", \"Outstanding_Quantity\", \"Unit_of_Measure_Code\", \"Line_Amount\", \"Shipment_Date\", \"Location_Code\", \"Sell_to_Customer_No\"] },\n  { sheet:'Invoices',      table:'Table3',   rows:store.invoices,     cols:[\"No\", \"Posting_Date\", \"Due_Date\", \"Order_No\", \"Sell_to_Customer_No\", \"Sell_to_Customer_Name\", \"Ship_to_Name\", \"Ship_to_City\", \"Shipping_Agent_Code\", \"External_Document_No\", \"Salesperson_Code\", \"Payment_Terms_Code\", \"Location_Code\"] },\n  { sheet:'Invoice Lines', table:'Table4',   rows:store.invoiceLines, cols:[\"Document_No\", \"Line_No\", \"Type\", \"No\", \"Description\", \"Quantity\", \"Unit_of_Measure_Code\", \"Unit_Price\", \"Line_Discount_Amount\", \"Amount\", \"Amount_Including_VAT\", \"ERC_Posting_Date\", \"Sell_to_Customer_No\", \"Order_No\"] },\n  { sheet:'Combined',      table:'Combined', rows:combined,           cols:[\"SO Number\", \"Status\", \"Requested_Delivery_Date\", \"No\", \"Description\", \"Quantity\", \"Unit Price\", \"Line_Amount\", \"Sell_to_Customer_No\", \"Sell_to_Customer_Name\"] }\n];\n\nstore.sheets = sheets;\nstore.old = {};\nreturn sheets.map(s => ({ json: { sheet: s.sheet, table: s.table, sessionId, driveId, fileId } }));"
      },
