    {
      "parameters": {
        "jsCode": "const items = $input.first().json.results || [];\nif (items.length === 0) { return [{ json: { error: 'No associated items' } }]; }\nconst STAGE_ORDER = { '1386096010':0, '1388087301':1, '1388087302':2, '1386096011':3 };\nlet lowestStage=null, lowestRank=Infinity; const stages=[];\nfor (const item of items){ const st=String(item.properties.hs_pipeline_stage); stages.push(st); const r=STAGE_ORDER[st]; if(r!==undefined && r<lowestRank){lowestRank=r; lowestStage=st;} }\nif (lowestStage===null){ return [{ json:{ error:'No recognized item stages', stages } }]; }\nconst _OWNER={grant:'90350604',jessica:'583682960',barbara:'967443664'};\nconst _GRANT=['Shortage','Wrong Substitution','Mispick']; const _JESSICA=['Incorrect Price','Order Error'];\nconst _itemOwnerFn=(stage,ct)=>{ if(stage==='1386096011')return null; if(stage==='1388087301')return _OWNER.jessica; if(_GRANT.includes(ct))return _OWNER.grant; if(_JESSICA.includes(ct))return _OWNER.jessica; return _OWNER.barbara; };\nconst _ticketOwnerFn=(s)=>{ if(s==='1386096010')return _OWNER.barbara; if(s==='1388087301')return _OWNER.jessica; if(s==='1388087302')return _OWNER.barbara; return null; };\nconst triggerId = String($('Extract Item Info').first().json.itemId || '');\nconst trig = items.find(i=>String(i.id)===triggerId);\nlet triggerItemOwner=null;\nif (trig){ triggerItemOwner=_itemOwnerFn(String(trig.properties.hs_pipeline_stage), trig.properties.complaint_type||''); }\nconst ticketOwner=_ticketOwnerFn(lowestStage);\nreturn [{ json: { itemStage: lowestStage, triggerItemId: triggerId, triggerItemOwner, ticketOwner, allStages: stages, itemCount: items.length, success: true } }];"
      },
      "id": "2175c935-457a-4ef4-8114-6bd6bda80ee7",
      "name": "Get Item Stage",
