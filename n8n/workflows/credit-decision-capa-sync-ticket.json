{
  "name": "Credit Decision to CAPA - Sync Ticket",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "Credit Decision to CAPA",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "db189cd8-2383-4a4f-bbe5-197575ffc1f9",
      "name": "Webhook - Item Stage Changed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 96],
      "webhookId": "80574754-67d6-4e79-b7a7-932bc8fdccc7"
    },
    {
      "parameters": {
        "jsCode": "const webhookInput = $input.first().json;\nconst body = webhookInput.body || webhookInput;\nconst itemId = body.objectId || body.id;\nconst newStage = body.properties?.hs_pipeline_stage?.value || body.hs_pipeline_stage;\n\nif (!itemId || !newStage) {\n  return [{ json: { error: 'Missing itemId or stage', received: body } }];\n}\n\nreturn [{ json: { itemId, newStage } }];"
      },
      "id": "50ea9424-d8ad-482c-a14e-c7bc7616f771",
      "name": "Extract Item Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 96]
    },
    {
      "parameters": {
        "jsCode": "const newStage = String($json.newStage);\nconst allowedStages = ['1388087301', '1388087302'];\n\nif (!allowedStages.includes(newStage)) {\n  return [];\n}\n\nreturn [{ json: { itemId: $json.itemId, newStage: newStage } }];"
      },
      "id": "3345bd50-f8bb-4650-8f2d-06e80e3998b5",
      "name": "Validate Stage (Credit Decision or CAPA)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 96]
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/2-48651243/{{ $json.itemId }}/associations/tickets",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "4e0fae74-6bec-4242-995e-7a56ed36cf37",
      "name": "Get Associated Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [672, 0],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst results = response.results || [];\n\nif (results.length === 0) {\n  return [{ json: { error: 'No associated ticket found' } }];\n}\n\nconst ticketId = results[0].id;\nreturn [{ json: { ticketId } }];"
      },
      "id": "100a390c-130b-4827-9625-71c6f59a3919",
      "name": "Extract Ticket ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 0]
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/tickets/{{ $json.ticketId }}/associations/2-48651243",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "e810c3dd-aa21-4b33-8cdf-38af2fe7a4b1",
      "name": "Get All Associated Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 0],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const allItemsResponse = $input.first().json;\nconst itemResults = allItemsResponse.results || [];\n\nif (itemResults.length === 0) {\n  return [{ json: { error: 'No associated items' } }];\n}\n\nconst itemIds = itemResults.map(r => r.id);\nconst stages = [];\n\n// Fetch each item's stage from HubSpot\nconst credentials = $credentials.get('hubspotAppToken');\nconst apiKey = credentials?.apiKey || credentials?.token;\n\nfor (const itemId of itemIds) {\n  const url = `https://api.hubapi.com/crm/v3/objects/2-48651243/${itemId}?properties=hs_pipeline_stage`;\n  try {\n    const response = await fetch(url, {\n      method: 'GET',\n      headers: {\n        'Authorization': `Bearer ${apiKey}`,\n        'Content-Type': 'application/json'\n      }\n    });\n    const data = await response.json();\n    const stage = data.properties?.hs_pipeline_stage?.value;\n    if (stage !== undefined) {\n      stages.push(stage);\n    }\n  } catch (error) {\n    // Continue fetching other items even if one fails\n  }\n}\n\nif (stages.length === 0) {\n  return [{ json: { error: 'Could not fetch any item stages' } }];\n}\n\n// Find the lowest/earliest stage (minimum numeric value)\nconst lowestStage = Math.min(...stages.map(s => parseInt(s)));\n\nreturn [{ json: { itemStage: String(lowestStage), allStages: stages, itemCount: itemIds.length, success: true } }];"
      },
      "id": "2175c935-457a-4ef4-8114-6bd6bda80ee7",
      "name": "Get Item Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1344, 0]
    },
    {
      "parameters": {
        "jsCode": "const itemStage = $json.itemStage;\nconst stageMapping = {\n  '1388087301': '1387983013',\n  '1388087302': '1387983014'\n};\n\nconst ticketStage = stageMapping[itemStage];\n\nif (!ticketStage) {\n  return [{ json: { error: 'No ticket stage mapping for item stage: ' + itemStage } }];\n}\n\nreturn [{ json: { ticketStage: ticketStage, itemStage: itemStage } }];"
      },
      "id": "db993a4c-484b-4477-9bd9-122164471e9c",
      "name": "Map Item Stage to Ticket Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1568, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/tickets/{{ $('Extract Ticket ID').first().json.ticketId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { hs_pipeline_stage: $json.ticketStage } }) }}",
        "options": {}
      },
      "id": "6146fd25-6ac7-48e3-abe6-934b69bb2552",
      "name": "Update Ticket Stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1792, 0],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Ticket synced to lowest item stage', ticketStage: $json.ticketStage }) }}",
        "options": {
