      "position": [
        1568,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const itemStage = $json.itemStage;\nconst stageMapping = { '1386096010':'1385996039','1388087301':'1387983013','1388087302':'1387983014','1386096011':'1385996040' };\nconst ticketStage = stageMapping[itemStage];\nif (!ticketStage){ return [{ json:{ error:'No ticket stage mapping for item stage: '+itemStage } }]; }\nreturn [{ json: { ticketStage, itemStage, ticketOwner: $json.ticketOwner || null } }];"
      },
