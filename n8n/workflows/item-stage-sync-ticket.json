            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Item Stage": {
      "main": [
        [
          {
            "node": "Map Item Stage to Ticket Stage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map Item Stage to Ticket Stage": {
      "main": [
        [
          {
