        "jsCode": "const searchResult = $input.first().json;\nconst store = $getWorkflowStaticData('global');\nconst original = $('Validate Payload').first().json;\n\nstore.companyId = searchResult.results[0].id;\nstore.companyName = searchResult.results[0].properties.name || '';\nstore.payload = original;\n\nreturn [{ json: {\n  email: original.contact.email,\n  firstname: original.contact.firstName,\n  lastname: original.contact.lastName,\n  phone: original.contact.phone || ''\n} }];"
