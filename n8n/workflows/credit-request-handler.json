    {
      "parameters": {
        "jsCode": "const webhookBinary = $('Webhook').first().binary || {};\nconst store = $getWorkflowStaticData('global');\n\nconst filesToUpload = [];\n\nfor (const key of Object.keys(webhookBinary)) {\n  const match = key.match(/^photo_line(\\d+)_file(\\d+)$/);\n  if (!match) {\n    const legacyMatch = key.match(/^photos_line_(\\d+)/);\n    if (!legacyMatch) continue;\n    const lineNum = legacyMatch[1];\n    filesToUpload.push({\n      json: {\n        lineNum: lineNum,\n        fileName: webhookBinary[key].fileName || key\n      },\n      binary: { data: webhookBinary[key] }\n    });\n    continue;\n  }\n  const lineNum = match[1];\n  filesToUpload.push({\n    json: {\n      lineNum: lineNum,\n      fileName: webhookBinary[key].fileName || key\n    },\n    binary: { data: webhookBinary[key] }\n  });\n}\n\nstore.uploadedUrls = {};\n\nif (filesToUpload.length === 0) {\n  return [{ json: { hasFiles: false } }];\n}\n\nreturn filesToUpload.map(f => ({\n  json: { ...f.json, hasFiles: true },\n  binary: f.binary\n}));"
      },
