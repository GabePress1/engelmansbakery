      "id": "cr-handler-009",
      "name": "Create Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1320, -400],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst response = $input.first().json;\nconst original = store.payload;\n\nlet contactId;\nif (response.statusCode === 409 || (response.body && response.body.status === 'error' && response.body.message && response.body.message.includes('already exists'))) {\n  const existingId = response.body?.message?.match(/Existing ID: (\\d+)/)?.[1];\n  if (existingId) {\n    contactId = existingId;\n  } else {\n    // Search for contact by email as fallback\n    store.needContactSearch = true;\n    return [{ json: { email: original.contact.email } }];\n  }\n} else {\n  contactId = response.id || (response.body && response.body.id);\n}\n\nstore.contactId = contactId;\n\nconst lines = original.productLines;\nconst linesSummary = lines.map((l, i) =>\n  `Line ${i+1}: ${l.productNumber} (${l.productDescription || ''}) × ${l.quantity} — ${l.issueClassification} — $${parseFloat(l.creditAmount).toFixed(2)}${l.notes ? ' — ' + l.notes : ''}`\n).join('\\n');\n\nconst summary = `Credit Request — Acct #${original.account.accountNumber} (${original.account.accountName || store.companyName})\\n${linesSummary}\\nTotal Credit Requested: $${original.totalCreditRequested.toFixed(2)}${original.ticketNotes ? '\\nNotes: ' + original.ticketNotes : ''}`;\n\nstore.creditSummary = summary;\n\nreturn [{ json: {\n  subject: `Credit Request — Acct #${original.account.accountNumber}`,\n  credit_summary: summary,\n  total_credit_requested: original.totalCreditRequested,\n  hs_pipeline: '912400389',\n  hs_pipeline_stage: '1385996039',\n  complaint_type: original.productLines[0].issueClassification\n} }];"
      },
