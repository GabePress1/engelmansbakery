    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst upsertResponse = $('Upsert Contact').first().json;\nconst original = store.payload;\n\nconst contactId = upsertResponse.results[0].id;\nstore.contactId = contactId;\n\nconst lines = original.productLines;\nconst linesSummary = lines.map((l, i) =>\n  `Line ${i+1}: ${l.productNumber} (${l.productDescription || ''}) \u00d7 ${l.quantity} \u2014 ${l.issueClassification} \u2014 $${parseFloat(l.creditAmount).toFixed(2)}${l.notes ? ' \u2014 ' + l.notes : ''}`\n).join('\\n');\n\nconst summary = `Credit Request \u2014 Acct #${original.account.accountNumber} (${original.account.accountName || store.companyName})\\n${linesSummary}\\nTotal Credit Requested: $${original.totalCreditRequested.toFixed(2)}${original.ticketNotes ? '\\nNotes: ' + original.ticketNotes : ''}`;\n\nstore.creditSummary = summary;\n\nconst uploadedUrls = store.uploadedUrls || {};\nconst allPhotos = Object.keys(uploadedUrls)\n  .sort((a, b) => Number(a) - Number(b))\n  .flatMap(lineNum => uploadedUrls[lineNum].map(url => url))\n  .join('\\n');\n\nconst now = new Date(original.submittedAt);\nconst yy = String(now.getFullYear()).slice(2);\nconst mm = String(now.getMonth() + 1).padStart(2, '0');\nconst dd = String(now.getDate()).padStart(2, '0');\nconst submissionDate = `${yy}-${mm}-${dd}`;\n\nreturn [{ json: {\n  subject: `${original.account.accountNumber} - ${submissionDate}`,\n  account__: original.account.accountNumber,\n  company_name: original.account.accountName || store.companyName,\n  invoice: original.account.invoiceNumber || '',\n  credit_summary: summary,\n  total_credit_requested: original.totalCreditRequested,\n  hs_pipeline: '912400389',\n  hs_pipeline_stage: '1385996039',\n  photosdocumentation: allPhotos\n} }];"
      },
