    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet body;\nif (raw.body && raw.body.data) {\n  body = JSON.parse(raw.body.data);\n} else if (raw.data && typeof raw.data === 'string') {\n  body = JSON.parse(raw.data);\n} else {\n  body = raw.body || raw;\n}\nconst errors = [];\n\nif (!body.account || !body.account.accountNumber) errors.push('Account number is required');\nif (!body.contact) errors.push('Contact information is required');\nelse {\n  if (!body.contact.firstName) errors.push('First name is required');\n  if (!body.contact.lastName) errors.push('Last name is required');\n  if (!body.contact.email) errors.push('Email is required');\n}\nif (!body.productLines || !Array.isArray(body.productLines) || body.productLines.length === 0) {\n  errors.push('At least one product line is required');\n} else if (body.productLines.length > 10) {\n  errors.push('Maximum 10 product lines allowed');\n} else {\n  body.productLines.forEach((line, i) => {\n    if (!line.productNumber) errors.push(`Line ${i+1}: Product number is required`);\n    if (!line.quantity || line.quantity < 1) errors.push(`Line ${i+1}: Valid quantity is required`);\n    if (!line.creditAmount || line.creditAmount <= 0) errors.push(`Line ${i+1}: Valid credit amount is required`);\n    if (!line.issueClassification) errors.push(`Line ${i+1}: Issue classification is required`);\n  });\n}\n\nif (errors.length > 0) {\n  return [{ json: { validationError: true, errors, message: errors.join('; ') } }];\n}\n\nconst totalCredit = body.productLines.reduce((sum, l) => sum + (parseFloat(l.creditAmount) || 0), 0);\nbody.totalCreditRequested = Math.round(totalCredit * 100) / 100;\nbody.totalLineItems = body.productLines.length;\n\nreturn [{ json: body }];"
      },
