    {
      "parameters": {
        "functionCode": "// Merge invoices and sales orders into a single parent table\nconst parentData = [];\n\nif (Array.isArray(items[0])) {\n  parentData.push(...items[0]);\n}\nif (Array.isArray(items[1])) {\n  parentData.push(...items[1]);\n}\n\nreturn parentData;"
      },
      "id": "Merge Parent Data",
      "name": "Merge Parent Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        850,
        250
      ]
    },
    {
      "parameters": {
        "functionCode": "// Merge invoice lines and sales order lines into a single detail table\nconst detailData = [];\n\nif (Array.isArray(items[0])) {\n  detailData.push(...items[0]);\n}\nif (Array.isArray(items[1])) {\n  detailData.push(...items[1]);\n}\n\nreturn detailData;"
      },
      "id": "Merge Detail Data",
      "name": "Merge Detail Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        850,
        400
      ]
    },
    {
      "parameters": {
        "functionCode": "const XLSX = require('xlsx');\n\nconst parentData = items[0];\nconst detailData = items[1];\n\n// Create a new workbook\nconst workbook = XLSX.utils.book_new();\n\n// Convert parent data to worksheet\nconst parentSheet = XLSX.utils.json_to_sheet(parentData);\nXLSX.utils.book_append_sheet(workbook, parentSheet, 'Documents');\n\n// Convert detail data to worksheet\nconst detailSheet = XLSX.utils.json_to_sheet(detailData);\nXLSX.utils.book_append_sheet(workbook, detailSheet, 'Line Items');\n\n// Return the workbook as binary data\nconst buffer = XLSX.write(workbook, {bookType: 'xlsx', type: 'buffer'});\n\nreturn [{\n  fileName: 'BusinessCentral_Route21_Export.xlsx',\n  data: buffer.toString('base64'),\n  mimeType: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'\n}];"
      },
      "id": "Generate Excel File",
      "name": "Generate Excel File",
      "type": "n8n-nodes-base.function",
