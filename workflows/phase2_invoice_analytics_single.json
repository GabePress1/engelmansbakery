      "name": "Find HubSpot Company",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        896,
        0
      ],
      "credentials": {
        "hubspotAppToken": {
          "id": "CREDENTIAL_ID",
          "name": "BC to HubSpot"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/companies/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  filterGroups: [{ filters: [{\n    propertyName: 'erp_account_number', operator: 'EQ',\n    value: $('Customer ERP').first().json.erp_number\n  }] }],\n  properties: ['hs_object_id', 'erp_account_number', 'name'],\n  limit: 1\n}) }}",
        "options": {}
      }
    },
    {
      "id": "b737c956-92aa-4a2d-8c3b-9a9571727388",
      "name": "Fetch Last 10 Invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "url": "=https://api.businesscentral.dynamics.com/v2.0/{{ $('Keys').first().json.Tenant_ID }}/production/api/v2.0/companies({{ $('Keys').first().json.Company_ID }})/salesInvoices",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$filter",
              "value": "={{ `customerNumber eq '${$('Customer ERP').first().json.erp_number}'` }}"
            },
            {
              "name": "$select",
              "value": "number,customerNumber,customerName,invoiceDate,totalAmountIncludingTax"
            },
            {
              "name": "$orderby",
              "value": "invoiceDate desc"
            },
            {
              "name": "$top",
              "value": "10"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get BC Token').first().json.access_token }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "07e51287-f286-43c2-84ef-07b8ab807e06",
      "name": "Calculate Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "jsCode": "const invoiceData = $input.first().json.value || [];\nconst hsResult    = $('Find HubSpot Company').first().json.results?.[0];\n\nif (!hsResult) return [{ json: { error: 'HubSpot company not found for this ERP' } }];\nif (invoiceData.length === 0) return [{ json: { error: 'No invoices found in BC', hsId: hsResult.id } }];\n\nconst invList = invoiceData; // already sorted desc, max 10\n\n// 1. Last invoice date (ms epoch)\nconst lastInvoiceDate = new Date(invList[0].invoiceDate + 'T00:00:00Z').getTime();\n\n// 2. Avg order size\nconst avgOrderSize = Math.round(\n  (invList.reduce((s, i) => s + (Number(i.totalAmountIncludingTax) || 0), 0) / invList.length) * 100\n) / 100;\n\n// 3. Avg days between orders\nlet avgDaysBetweenOrders = null;\nconst sortedAsc = [...invList].sort((a, b) => new Date(a.invoiceDate) - new Date(b.invoiceDate));\nif (sortedAsc.length >= 2) {\n  const gaps = [];\n  for (let i = 1; i < sortedAsc.length; i++) {\n    gaps.push((new Date(sortedAsc[i].invoiceDate) - new Date(sortedAsc[i-1].invoiceDate))\n               / (1000 * 60 * 60 * 24));\n  }\n  avgDaysBetweenOrders = Math.round((gaps.reduce((s, g) => s + g, 0) / gaps.length) * 10) / 10;\n}\n\nconst props = { last_invoice_date: lastInvoiceDate, avg_order_size: avgOrderSize };\nif (avgDaysBetweenOrders !== null) props.avg_days_between_orders = avgDaysBetweenOrders;\n\nreturn [{ json: {\n  hsId: hsResult.id,\n  customerName: hsResult.properties?.name,\n  lastInvoiceDate: invList[0].invoiceDate,\n  avgOrderSize,\n  avgDaysBetweenOrders,\n  invoiceCount: invList.length,\n  hsUpdatePayload: props\n} }];"
      }
    },
    {
