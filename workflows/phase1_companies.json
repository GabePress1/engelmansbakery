{
  "name": "Phase 1 – BC → HubSpot Companies",
  "nodes": [
    {
      "id": "p1-0001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 6 * * 1-5" }]
        }
      }
    },
    {
      "id": "p1-0002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [220, 300],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "cfg-1", "name": "EXCEL_WORKBOOK_ID", "value": "PASTE_YOUR_WORKBOOK_ID_HERE", "type": "string" },
            { "id": "cfg-2", "name": "BC_BASE_URL",        "value": "PASTE_YOUR_BC_API_BASE_URL_HERE", "type": "string" },
            { "id": "cfg-3", "name": "BC_COMPANY_ID",      "value": "PASTE_YOUR_BC_COMPANY_GUID_HERE", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "p1-0003",
      "name": "Read Sync Log",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [440, 300],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "getRows",
        "workbook":   { "__rl": true, "value": "={{ $('Config').first().json.EXCEL_WORKBOOK_ID }}", "mode": "id" },
        "worksheet":  { "__rl": true, "value": "sync_log", "mode": "name" },
        "returnAll": true,
        "options": { "dataStartRow": 2 }
      }
    },
    {
      "id": "p1-0004",
      "name": "Set Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300],
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst phase1 = rows\n  .filter(r => r.json.phase === 'phase1')\n  .sort((a, b) => new Date(b.json.run_date) - new Date(a.json.run_date));\nconst lastTimestamp = phase1.length > 0 ? phase1[0].json.last_bc_timestamp : '2000-01-01T00:00:00Z';\nreturn [{ json: { lastTimestamp, runDate: new Date().toISOString() } }];"
      }
    },
    {
      "id": "p1-0005",
      "name": "Read Customer Sheet",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [880, 300],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "getRows",
        "workbook":   { "__rl": true, "value": "={{ $('Config').first().json.EXCEL_WORKBOOK_ID }}", "mode": "id" },
        "worksheet":  { "__rl": true, "value": "Customer", "mode": "name" },
        "returnAll": true,
        "options": { "dataStartRow": 2 }
      }
    },
    {
      "id": "p1-0006",
      "name": "Fetch Changed BC Customers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1100, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.BC_BASE_URL }}/companies({{ $('Config').first().json.BC_COMPANY_ID }})/customers",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/json" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$filter",
              "value": "={{ `lastModifiedDateTime gt ${$('Set Window').first().json.lastTimestamp}` }}"
            },
            {
              "name": "$select",
              "value": "id,number,displayName,email,phoneNumber,addressLine1,city,state,postalCode,country,salespersonCode,paymentTermsId,paymentMethodId,creditLimit,blocked,balance,balanceDue,lastModifiedDateTime"
            },
            { "name": "$top", "value": "500" }
          ]
        }
      }
    },
    {
      "id": "p1-0007",
      "name": "Expand Customers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 300],
      "parameters": {
        "jsCode": "const customers = $input.first().json.value || [];\nreturn customers.map(c => ({ json: c }));"
      }
    },
    {
      "id": "p1-0008",
      "name": "Loop Over Customers",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1540, 300],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "p1-0009",
      "name": "Look Up HubSpot ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 200],
      "parameters": {
        "jsCode": "const customer = $input.first().json;\nconst sheetRows = $('Read Customer Sheet').all();\nconst match = sheetRows.find(r => String(r.json.erp_account_number) === String(customer.number));\nreturn [{\n  json: {\n    ...customer,\n    hubspotId: match ? match.json.hubspot_id : null,\n    isNew: !match\n  }\n}];"
      }
    },
    {
      "id": "p1-0010",
      "name": "New or Existing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 200],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.isNew }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equal" }
            }
          ]
        }
      }
    },
    {
      "id": "p1-0011",
      "name": "Create HubSpot Company",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [2200, 100],
      "credentials": { "hubspotApi": { "name": "HubSpot - Engelmans" } },
      "parameters": {
        "resource": "company",
        "operation": "create",
        "additionalFields": {
          "name":            "={{ $json.displayName }}",
          "phone":           "={{ $json.phoneNumber }}",
          "address":         "={{ $json.addressLine1 }}",
          "city":            "={{ $json.city }}",
          "state":           "={{ $json.state }}",
          "zip":             "={{ $json.postalCode }}",
          "country":         "={{ $json.country }}",
          "payment_terms":   "={{ $json.paymentTermsId }}",
          "payment_method":  "={{ $json.paymentMethodId }}",
          "credit_limit":    "={{ $json.creditLimit }}",
          "blocked":         "={{ $json.blocked }}",
          "balance":         "={{ $json.balance }}",
          "balance_due":     "={{ $json.balanceDue }}",
          "salesperson":     "={{ $json.salespersonCode }}"
        }
      }
    },
    {
      "id": "p1-0012",
      "name": "Write New Customer Row",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [2420, 100],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "append",
        "workbook":  { "__rl": true, "value": "={{ $('Config').first().json.EXCEL_WORKBOOK_ID }}", "mode": "id" },
        "worksheet": { "__rl": true, "value": "Customer", "mode": "name" },
        "keyRow": 1,
        "dataStartRow": 2,
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "erp_account_number": "={{ $('Loop Over Customers').first().json.number }}",
            "hubspot_id":         "={{ $json.id }}",
            "Name":               "={{ $('Loop Over Customers').first().json.displayName }}",
            "Owner":              "={{ $('Loop Over Customers').first().json.salespersonCode }}",
            "Payment_Terms":      "={{ $('Loop Over Customers').first().json.paymentTermsId }}",
            "Payment_Method":     "={{ $('Loop Over Customers').first().json.paymentMethodId }}",
            "Credit_Limit":       "={{ $('Loop Over Customers').first().json.creditLimit }}",
            "Blocked":            "={{ $('Loop Over Customers').first().json.blocked }}",
            "Balance":            "={{ $('Loop Over Customers').first().json.balance }}",
            "Balance_Due":        "={{ $('Loop Over Customers').first().json.balanceDue }}",
            "Route":              "",
            "Calender":           "",
            "last_synced":        "={{ $('Set Window').first().json.runDate }}"
          }
        }
      }
    },
    {
      "id": "p1-0013",
      "name": "Update HubSpot Company",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [2200, 320],
      "credentials": { "hubspotApi": { "name": "HubSpot - Engelmans" } },
      "parameters": {
        "resource": "company",
        "operation": "update",
        "companyId": "={{ $json.hubspotId }}",
        "updateFields": {
          "name":            "={{ $json.displayName }}",
          "phone":           "={{ $json.phoneNumber }}",
          "address":         "={{ $json.addressLine1 }}",
          "city":            "={{ $json.city }}",
          "state":           "={{ $json.state }}",
          "zip":             "={{ $json.postalCode }}",
          "country":         "={{ $json.country }}",
          "payment_terms":   "={{ $json.paymentTermsId }}",
          "payment_method":  "={{ $json.paymentMethodId }}",
          "credit_limit":    "={{ $json.creditLimit }}",
          "blocked":         "={{ $json.blocked }}",
          "balance":         "={{ $json.balance }}",
          "balance_due":     "={{ $json.balanceDue }}",
          "salesperson":     "={{ $json.salespersonCode }}"
        }
      }
    },
    {
      "id": "p1-0014",
      "name": "Update Customer Row",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [2420, 320],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "appendOrUpdate",
        "workbook":  { "__rl": true, "value": "={{ $('Config').first().json.EXCEL_WORKBOOK_ID }}", "mode": "id" },
        "worksheet": { "__rl": true, "value": "Customer", "mode": "name" },
        "keyRow": 1,
        "dataStartRow": 2,
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "erp_account_number": "={{ $('Loop Over Customers').first().json.number }}",
            "hubspot_id":         "={{ $('Look Up HubSpot ID').first().json.hubspotId }}",
            "Name":               "={{ $('Loop Over Customers').first().json.displayName }}",
            "Owner":              "={{ $('Loop Over Customers').first().json.salespersonCode }}",
            "Payment_Terms":      "={{ $('Loop Over Customers').first().json.paymentTermsId }}",
            "Payment_Method":     "={{ $('Loop Over Customers').first().json.paymentMethodId }}",
            "Credit_Limit":       "={{ $('Loop Over Customers').first().json.creditLimit }}",
            "Blocked":            "={{ $('Loop Over Customers').first().json.blocked }}",
            "Balance":            "={{ $('Loop Over Customers').first().json.balance }}",
            "Balance_Due":        "={{ $('Loop Over Customers').first().json.balanceDue }}",
            "last_synced":        "={{ $('Set Window').first().json.runDate }}"
          }
        }
      }
    },
    {
      "id": "p1-0015",
      "name": "Write Sync Log",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [1540, 460],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "append",
        "workbook":  { "__rl": true, "value": "={{ $('Config').first().json.EXCEL_WORKBOOK_ID }}", "mode": "id" },
        "worksheet": { "__rl": true, "value": "sync_log", "mode": "name" },
        "keyRow": 1,
        "dataStartRow": 2,
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_date":           "={{ $('Set Window').first().json.runDate }}",
            "phase":              "phase1",
            "records_processed":  "={{ $('Expand Customers').all().length }}",
            "last_bc_timestamp":  "={{ $('Set Window').first().json.runDate }}"
          }
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger":          { "main": [[{ "node": "Config",                     "type": "main", "index": 0 }]] },
    "Config":                    { "main": [[{ "node": "Read Sync Log",              "type": "main", "index": 0 }]] },
    "Read Sync Log":             { "main": [[{ "node": "Set Window",                 "type": "main", "index": 0 }]] },
    "Set Window":                { "main": [[{ "node": "Read Customer Sheet",        "type": "main", "index": 0 }]] },
    "Read Customer Sheet":       { "main": [[{ "node": "Fetch Changed BC Customers", "type": "main", "index": 0 }]] },
    "Fetch Changed BC Customers":{ "main": [[{ "node": "Expand Customers",           "type": "main", "index": 0 }]] },
    "Expand Customers":          { "main": [[{ "node": "Loop Over Customers",        "type": "main", "index": 0 }]] },
    "Loop Over Customers": {
      "main": [
        [{ "node": "Look Up HubSpot ID", "type": "main", "index": 0 }],
        [{ "node": "Write Sync Log",     "type": "main", "index": 0 }]
      ]
    },
    "Look Up HubSpot ID":    { "main": [[{ "node": "New or Existing?",        "type": "main", "index": 0 }]] },
    "New or Existing?": {
      "main": [
        [{ "node": "Create HubSpot Company", "type": "main", "index": 0 }],
        [{ "node": "Update HubSpot Company", "type": "main", "index": 0 }]
      ]
    },
    "Create HubSpot Company": { "main": [[{ "node": "Write New Customer Row", "type": "main", "index": 0 }]] },
    "Write New Customer Row":  { "main": [[{ "node": "Loop Over Customers",   "type": "main", "index": 0 }]] },
    "Update HubSpot Company":  { "main": [[{ "node": "Update Customer Row",   "type": "main", "index": 0 }]] },
    "Update Customer Row":     { "main": [[{ "node": "Loop Over Customers",   "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
