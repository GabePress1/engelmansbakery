    {
      "parameters": {
        "jsCode": "const hsResults = $input.first().json.results || [];\nconst store = $getWorkflowStaticData('global');\nconst chunkCustomers  = store.currentChunkCustomers || [];\nconst shipToMap       = store.shipToMap || {};\nconst createdThisRun  = store.createdThisRun || {};\n\nconst hsMap = {};\nfor (const r of hsResults) {\n  const erpNum = r.properties?.erp_account_number;\n  if (erpNum) hsMap[String(erpNum)] = r.id;\n}\n\nfunction buildProps(c) {\n  const erpNum = String(c.number);\n  const ship   = shipToMap[erpNum] || {};\n  const blocked = (c.blocked && c.blocked.trim() && c.blocked.trim() !== '_x0020_') ? c.blocked.trim() : null;\n  const raw = {\n    erp_account_number:       erpNum,\n    name:                     c.displayName  || null,\n    phone:                    c.phoneNumber  || null,\n    // Billing address \u2192 billing_* properties\n    billing_street_address:   c.addressLine1 || null,\n    billing_street_address_2: c.addressLine2 || null,\n    // Shipping address \u2192 standard address/city/zip (HubSpot internal names)\n    address:                  ship.address   || null,\n    address2:                 ship.address2  || null,\n    city:                     ship.city      || null,\n    zip:                      ship.zip       || null,\n    // State and country from billing (not available in ship-to data)\n    state:                    c.state        || null,\n    country:                  c.country      || null,\n    payment_terms_code:       c.paymentTerm?.code   || null,\n    payment_method_code:      c.paymentMethod?.code || null,\n    credit_limit:             c.creditLimit != null ? c.creditLimit : null,\n    blocked\n  };\n  const props = {};\n  for (const [k, v] of Object.entries(raw)) {\n    if (v !== null && v !== undefined && v !== '') props[k] = v;\n  }\n  return props;\n}\n\nconst toUpdate = [], toCreate = [];\nfor (const c of chunkCustomers) {\n  const erpNum = String(c.number);\n  const props  = buildProps(c);\n  if (hsMap[erpNum]) {\n    toUpdate.push({ id: hsMap[erpNum], properties: props });\n  } else if (!createdThisRun[erpNum]) {\n    toCreate.push({ properties: props });\n    createdThisRun[erpNum] = true;\n  }\n}\nstore.createdThisRun = createdThisRun;\n\nreturn [{ json: { toUpdate, toCreate } }];"
      },
      "id": "p1-0029",
      "name": "Process Chunk",
      "type": "n8n-nodes-base.code",
