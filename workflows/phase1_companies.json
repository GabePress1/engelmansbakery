    {
      "parameters": {
        "url": "=https://api.businesscentral.dynamics.com/v2.0/{{ $('Keys').first().json.Tenant_ID }}/production/api/v2.0/companies({{ $('Keys').first().json.Company_ID }})/customers",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$filter",
              "value": "={{ `lastModifiedDateTime gt ${$('Set Window').first().json.lastTimestamp}` }}"
            },
            {
              "name": "$select",
              "value": "id,number,displayName,email,phoneNumber,addressLine1,addressLine2,city,state,postalCode,country,salespersonCode,creditLimit,blocked,lastModifiedDateTime"
            },
            {
              "name": "$expand",
              "value": "paymentTerm($select=code),paymentMethod($select=code)"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get BC Token').first().json.access_token }}"
