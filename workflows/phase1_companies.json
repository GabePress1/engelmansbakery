    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst lastTimestamp = store.lastPhase1Run || '2000-01-01T00:00:00Z';\nconst runDate = new Date().toISOString();\nstore.lastPhase1Run = runDate;\n// Reset the created-this-run set so dedup guard starts fresh each execution\nstore.createdThisRun = {};\nreturn [{ json: { lastTimestamp, runDate } }];"
      },
