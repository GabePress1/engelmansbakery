        "jsCode": "const chunk = $input.first().json;\nconst store = $getWorkflowStaticData('global');\nstore.currentChunkCustomers = chunk.chunkCustomers;\n// Pass only searchPayload forward so Search HubSpot node gets a clean item\nreturn [{ json: { searchPayload: chunk.searchPayload } }];"
      },
