      "id": "bb3bbed5-0bc2-4a62-9fea-e36b0aa23229",
      "name": "HTTP Request - Get All Ship-to Addresses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        896,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build a map of customerNumber \u2192 first ship-to address\nconst rows = $input.first().json.value || [];\nconst store = $getWorkflowStaticData('global');\nconst shipToMap = {};\nfor (const row of rows) {\n  const custNo = String(row.HFSCustomerNo || '').trim();\n  if (custNo && !shipToMap[custNo]) {\n    shipToMap[custNo] = {\n      address:  row.Address   || null,\n      address2: row.Address_2 || null,\n      city:     row.City      || null,\n      zip:      row.Post_Code || null\n    };\n  }\n}\nstore.shipToMap = shipToMap;\nreturn [{ json: { shipToLoaded: Object.keys(shipToMap).length } }];"
      },
      "id": "p1-0031",
      "name": "Store Ship-to Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -48
      ]
    }
