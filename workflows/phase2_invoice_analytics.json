      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.analyticsResults = [];\nstore.currentBatch = [];\nconst customers = $input.first().json.value || [];\nreturn customers.map(c => ({ json: c }));"
