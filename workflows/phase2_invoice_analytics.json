        "jsCode": "const store = $getWorkflowStaticData('global');\nconst results = store.analyticsResults || [];\nstore.analyticsResults = [];\nif (results.length === 0) return [{ json: { message: 'No results' } }];\nreturn results.map(r => ({ json: r }));"
      }
