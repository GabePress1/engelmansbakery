    {
      "id": "eaa985ff-b82c-4f00-93a3-615a8b1931a8",
      "name": "Fetch Invoices for Batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1792,
        0
      ],
      "parameters": {
        "url": "=https://api.businesscentral.dynamics.com/v2.0/{{ $('Keys').first().json.Tenant_ID }}/production/api/v2.0/companies({{ $('Keys').first().json.Company_ID }})/salesInvoices",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$filter",
              "value": "={{ $json.invoiceFilter }}"
            },
            {
              "name": "$select",
              "value": "number,customerNumber,customerName,invoiceDate,totalAmountIncludingTax"
            },
            {
              "name": "$orderby",
              "value": "invoiceDate desc"
            },
            {
              "name": "$top",
              "value": "1500"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get BC Token').first().json.access_token }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "65a0338d-c0c4-42fe-abbe-4efa73e4ae9a",
      "name": "Calculate Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        0
      ],
      "parameters": {
        "jsCode": "const invoiceData = $input.first().json.value || [];\nconst store = $getWorkflowStaticData('global');\nconst currentBatch = store.currentBatch || [];\n\nconst byCustomer = {};\nfor (const inv of invoiceData) {\n  const cust = String(inv.customerNumber || '');\n  if (!byCustomer[cust]) byCustomer[cust] = [];\n  byCustomer[cust].push(inv);\n}\n// invoiceData is sorted desc, so byCustomer[x][0] = most recent invoice\n\nconst results = store.analyticsResults || [];\n\nfor (const customer of currentBatch) {\n  const custNo   = String(customer.number || '');\n  const custName = customer.displayName || '';\n  const invList  = (byCustomer[custNo] || []).slice(0, 10); // last 10\n\n  if (invList.length === 0) {\n    results.push({ customerNumber: custNo, customerName: custName,\n      lastInvoiceDate: null, avgOrderSize: null, avgDaysBetweenOrders: null, invoiceCount: 0 });\n    continue;\n  }\n\n  const lastInvoiceDate = invList[0].invoiceDate;\n\n  const avgOrderSize = Math.round(\n    (invList.reduce((s, i) => s + (Number(i.totalAmountIncludingTax) || 0), 0) / invList.length) * 100\n  ) / 100;\n\n  const sortedAsc = [...invList].sort((a, b) => new Date(a.invoiceDate) - new Date(b.invoiceDate));\n  let avgDaysBetweenOrders = null;\n  if (sortedAsc.length >= 2) {\n    const gaps = [];\n    for (let i = 1; i < sortedAsc.length; i++) {\n      const days = (new Date(sortedAsc[i].invoiceDate) - new Date(sortedAsc[i-1].invoiceDate))\n                   / (1000 * 60 * 60 * 24);\n      gaps.push(days);\n    }\n    avgDaysBetweenOrders = Math.round((gaps.reduce((s, g) => s + g, 0) / gaps.length) * 10) / 10;\n  }\n\n  results.push({ customerNumber: custNo, customerName: custName,\n    lastInvoiceDate, avgOrderSize, avgDaysBetweenOrders, invoiceCount: invList.length });\n}\n\nstore.analyticsResults = results;\nreturn [{ json: { batchProcessed: currentBatch.length, totalSoFar: results.length } }];"
      }
    }
