    {
      "id": "903a0925-b584-4128-b85a-c1049b3a86d9",
      "name": "Build Invoice Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "jsCode": "const batchItems = $input.all();\nconst store = $getWorkflowStaticData('global');\nstore.currentBatch = batchItems.map(i => i.json);\nconst filter = batchItems\n  .map(item => `customerNumber eq '${String(item.json.number).replace(/'/g, \"''\")}'`)\n  .join(' or ');\nreturn [{ json: { invoiceFilter: filter } }];"
      }
    },
