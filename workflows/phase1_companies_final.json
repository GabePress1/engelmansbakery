        "url": "=https://api.businesscentral.dynamics.com/v2.0/{{ $('Keys').first().json.Tenant_ID }}/Production/ODataV4/Company('Live-EB')/Customer",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$select",
              "value": "No,Balance_LCY,Balance_Due_LCY,Shipping_Agent_Code,Base_Calendar_Code"
            },
