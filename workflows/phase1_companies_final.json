      "id": "f2b797f4-aff5-4c7f-a1f2-513f844f22fa",
      "name": "HTTP Request - Get Calendar & Balance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        4032,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const odataRows = $input.first().json.value || [];\nconst store = $getWorkflowStaticData('global');\nconst currentBatch = store.currentBatch || [];\nconst customerMap  = store.customerMap  || {};\nconst shipToMap    = store.shipToMap    || {};\n\nconst routeMap = {\n  'RT 1':  'Route 1',  'RT 2':  'Route 2',  'RT 3':  'Route 3',\n  'RT 4':  'Route 4',  'RT 5':  'Route 5',  'RT 6':  'Route 6',\n  'RT 7':  'Route 7',  'RT 8':  'Route 8',  'RT 9':  'Route 9',\n  'RT 10': 'Route 10', 'RT 11': 'Route 11', 'RT 12': 'Route 12',\n  'RT 13': 'Route 13', 'RT 15': '15 - Greenville',\n  'RT 16': 'Route 16 - Boxed', 'RT 20': 'Route 20 - Supervisor',\n  'RT 21': 'Route 21 - Distribution'\n};\nconst paymentMethodMap = {\n  'ACH':   'ACH Upon Due Date',   'CCA': 'Credit Card Auto',\n  'CCW':   'Credit Card Weekly',  'Check': 'Check',\n  'COD':   'Cash on Delivery',    'CCM': 'Credit Card Monthly',\n  'CCP':   'Credit Card Payment Plan'\n};\nconst salespersonMap = {\n  'CUDICK':  '90537115',\n  'DHALL':   '58718266',\n  'LLONG':   '53148531',\n  'GCOPLIN': '89639254',\n  'HWEST':   '53148526'\n};\n\nfunction calendarToDays(code) {\n  if (!code) return null;\n  const days = [];\n  let i = 0;\n  while (i < code.length) {\n    if (code.slice(i, i+2) === 'TH') { days.push('Thursday');  i += 2; }\n    else if (code[i] === 'M')        { days.push('Monday');    i++; }\n    else if (code[i] === 'T')        { days.push('Tuesday');   i++; }\n    else if (code[i] === 'W')        { days.push('Wednesday'); i++; }\n    else if (code[i] === 'F')        { days.push('Friday');    i++; }\n    else if (code[i] === 'S')        { days.push('Saturday');  i++; }\n    else i++;\n  }\n  const order = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];\n  return order.filter(d => days.includes(d)).join(';') || null;\n}\n\nconst odataMap = {};\nfor (const r of odataRows) odataMap[String(r.No)] = r;\n\nconst toUpdate = [];\nfor (const hsCompany of currentBatch) {\n  const erpNum = String(hsCompany.properties?.erp_account_number || '').trim();\n  if (!erpNum) continue;\n\n  const odata = odataMap[erpNum] || {};\n  const c     = customerMap[erpNum];\n  const ship  = shipToMap[erpNum] || {};\n  const raw   = {};\n\n  if (odata.Balance_LCY     != null) raw.balance     = odata.Balance_LCY;\n  if (odata.Balance_Due_LCY != null) raw.balance_due = odata.Balance_Due_LCY;\n  const rawRoute = odata.Shipping_Agent_Code ? String(odata.Shipping_Agent_Code).trim() : null;\n  if (rawRoute) { const r = routeMap[rawRoute]; if (r) raw.route = r; }\n  const days = calendarToDays(odata.Base_Calendar_Code);\n  if (days) raw.days_of_delivery = days;\n\n  if (ship.address)  raw.address  = ship.address;\n  if (ship.address2) raw.address2 = ship.address2;\n  if (ship.city)     raw.city     = ship.city;\n  if (ship.zip)      raw.zip      = ship.zip;\n\n  if (c) {\n    const bcBlocked = c.blocked && c.blocked.trim() && c.blocked.trim() !== '_x0020_';\n    if (c.displayName)  raw.name  = c.displayName;\n    if (c.addressLine1) raw.billing_street_address   = c.addressLine1;\n    if (c.addressLine2) raw.billing_street_address_2 = c.addressLine2;\n    if (c.city)         raw.billing_city             = c.city;\n    if (c.state)        raw.billing_state            = c.state;\n    const zip = c.postalCode != null ? String(c.postalCode).trim() : '';\n    if (zip) raw.billing_zip_code = zip;\n    raw.payment_terms_code  = c.paymentTerm?.code || null;\n    const pmCode = c.paymentMethod?.code;\n    raw.payment_method_code = (pmCode && paymentMethodMap[pmCode]) ? paymentMethodMap[pmCode] : null;\n    if (c.creditLimit != null) raw.credit_limit = c.creditLimit;\n    raw.blocked = bcBlocked ? 'Blocked' : '';\n    const spCode = c.salespersonCode ? String(c.salespersonCode).trim() : null;\n    if (spCode && salespersonMap[spCode]) raw.hubspot_owner_id = salespersonMap[spCode];\n  }\n\n  const props = {};\n  for (const [k, v] of Object.entries(raw)) {\n    if (v !== null && v !== undefined && v !== '') props[k] = v;\n  }\n  if (c && 'blocked' in raw)               props.blocked               = raw.blocked;\n  if (c && 'payment_terms_code' in raw)    props.payment_terms_code    = raw.payment_terms_code;\n  if (c && 'payment_method_code' in raw)   props.payment_method_code   = raw.payment_method_code;\n\n  if (Object.keys(props).length > 0) {\n    toUpdate.push({ id: hsCompany.id, properties: props });\n  }\n}\n\nreturn [{ json: { toUpdate, updateCount: toUpdate.length } }];"
      },
