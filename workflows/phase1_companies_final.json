    {
      "parameters": {
        "jsCode": "const batchItems = $input.all();\nconst store = $getWorkflowStaticData('global');\nstore.currentBatch = batchItems.map(i => i.json);\nconst odataFilter = batchItems\n  .map(item => {\n    const erpNum = item.json.properties?.erp_account_number || item.json.erp_account_number || '';\n    return `No eq '${String(erpNum).replace(/'/g, \"''\")}'`;\n  })\n  .join(' or ');\nreturn [{ json: { odataFilter } }];"
      },
      "id": "033d0602-5e4a-4480-9285-3e02f2b5a432",
      "name": "Build Calendar Filter",
