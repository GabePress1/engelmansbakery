    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst totalProcessed = (store.hsCompanies || []).length;\nstore.hsCompanies = [];\nstore.hsCursor = null;\nstore.customerMap = {};\nstore.balanceMap = {};\nstore.currentBatch = [];\nreturn [{ json: { message: 'Phase 1 Final complete', totalProcessed } }];"
