    {
      "parameters": {
        "jsCode": "const hsResults = $input.first().json.results || [];\nconst store = $getWorkflowStaticData('global');\nconst chunkCustomers  = store.currentChunkCustomers || [];\nconst shipToMap       = store.shipToMap    || {};\nconst balanceMap      = store.balanceMap   || {};\nconst createdThisRun  = store.createdThisRun || {};\n\nconst routeMap = {\n  'RT 1':  'Route 1',  'RT 2':  'Route 2',  'RT 3':  'Route 3',\n  'RT 4':  'Route 4',  'RT 5':  'Route 5',  'RT 6':  'Route 6',\n  'RT 7':  'Route 7',  'RT 8':  'Route 8',  'RT 9':  'Route 9',\n  'RT 10': 'Route 10', 'RT 11': 'Route 11', 'RT 12': 'Route 12',\n  'RT 13': 'Route 13', 'RT 15': '15 - Greenville',\n  'RT 16': 'Route 16 - Boxed', 'RT 20': 'Route 20 - Supervisor',\n  'RT 21': 'Route 21 - Distribution'\n};\n\nconst hsMap = {};\nfor (const r of hsResults) {\n  const erpNum = r.properties?.erp_account_number;\n  const rel    = (r.properties?.relationship || '').trim();\n  const divs   = (r.properties?.division_multiselect || '').split(';').map(d => d.trim());\n  const isOurs = rel === 'Customer' && divs.includes(\"Engelman's Bakery\");\n  if (erpNum && isOurs) hsMap[String(erpNum)] = r.id;\n}\n\nfunction buildProps(c) {\n  const erpNum = String(c.number);\n  const ship   = shipToMap[erpNum]  || {};\n  const bal    = balanceMap[erpNum] || {};\n  const bcBlocked = c.blocked && c.blocked.trim() && c.blocked.trim() !== '_x0020_';\n  const blocked = bcBlocked ? 'Blocked' : null;\n  const rawRoute = bal.route ? String(bal.route).trim() : null;\n  const route = rawRoute ? (routeMap[rawRoute] || null) : null;\n\n  const raw = {\n    erp_account_number:       erpNum,\n    name:                     c.displayName  || null,\n    phone:                    c.phoneNumber  || null,\n    billing_street_address:   c.addressLine1 || null,\n    billing_street_address_2: c.addressLine2 || null,\n    billing_city:             c.city         || null,\n    billing_state:            c.state        || null,\n    billing_zip_code:         (c.postalCode != null && String(c.postalCode).trim() !== '') ? String(c.postalCode).trim() : null,\n    country:                  c.country      || null,\n    address:                  ship.address   || null,\n    address2:                 ship.address2  || null,\n    city:                     ship.city      || null,\n    zip:                      ship.zip       || null,\n    balance:                  bal.balance     != null ? bal.balance     : null,\n    balance_due:              bal.balance_due != null ? bal.balance_due : null,\n    route,\n    days_of_delivery:         bal.calendar    || null,\n    payment_terms_code:       c.paymentTerm?.code   || null,\n    payment_method_code:      c.paymentMethod?.code || null,\n    credit_limit:             c.creditLimit != null ? c.creditLimit : null,\n    blocked\n  };\n  const props = {};\n  for (const [k, v] of Object.entries(raw)) {\n    if (v !== null && v !== undefined && v !== '') props[k] = v;\n  }\n  return props;\n}\n\nconst toUpdate = [], toCreate = [];\nfor (const c of chunkCustomers) {\n  const erpNum = String(c.number);\n  const props  = buildProps(c);\n  if (hsMap[erpNum]) {\n    toUpdate.push({ id: hsMap[erpNum], properties: props });\n  } else if (!createdThisRun[erpNum]) {\n    toCreate.push({ properties: { ...props, relationship: 'Customer', division_multiselect: \"Engelman's Bakery\" } });\n    createdThisRun[erpNum] = true;\n  }\n}\nstore.createdThisRun = createdThisRun;\n\nreturn [{ json: { toUpdate, toCreate } }];"
      },
