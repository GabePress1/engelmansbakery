        -48
      ]
    },
    {
      "parameters": {
        "url": "https://api.businesscentral.dynamics.com/v2.0/PASTE_YOUR_BC_TENANT_ID_HERE/Production/ODataV4/Company('Live-EB')/Customer",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$select",
              "value": "No,Balance_LCY,Balance_Due_LCY,Shipping_Agent_Code,Base_Calendar_Code"
            },
            {
              "name": "$filter",
              "value": "={{ $json.odataFilter }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get BC Token').first().json.access_token }}"
            }
          ]
        },
