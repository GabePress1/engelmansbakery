      "id": "40d9acd1-b025-498c-8beb-8e6c9ff74e04",
      "name": "HTTP Request - Get Calendar & Balance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2752,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.value || [];\nconst store = $getWorkflowStaticData('global');\nconst balanceMap = {};\n\nfunction calendarToDays(code) {\n  if (!code) return null;\n  const days = [];\n  let i = 0;\n  while (i < code.length) {\n    if (code.slice(i, i+2) === 'TH') { days.push('Thursday');  i += 2; }\n    else if (code[i] === 'M')         { days.push('Monday');    i++; }\n    else if (code[i] === 'T')         { days.push('Tuesday');   i++; }\n    else if (code[i] === 'W')         { days.push('Wednesday'); i++; }\n    else if (code[i] === 'F')         { days.push('Friday');    i++; }\n    else if (code[i] === 'S')         { days.push('Saturday');  i++; }\n    else                              { i++; }\n  }\n  return days.length > 0 ? days.join(';') : null;\n}\n\nfor (const row of rows) {\n  const custNo = String(row.No || '').trim();\n  if (!custNo) continue;\n  balanceMap[custNo] = {\n    balance:     row.Balance_LCY     ?? null,\n    balance_due: row.Balance_Due_LCY ?? null,\n    route:       (row.Shipping_Agent_Code || '').trim() || null,\n    calendar:    calendarToDays(row.Base_Calendar_Code)\n  };\n}\nstore.balanceMap = balanceMap;\n\n// Rebuild searchPayload so Search HubSpot Companies has what it needs\nconst customers = store.currentChunkCustomers || [];\nconst searchPayload = {\n  filterGroups: [{ filters: [{ propertyName: 'erp_account_number', operator: 'IN', values: customers.map(c => String(c.number)) }] }],\n  properties: ['hs_object_id', 'name', 'erp_account_number'],\n  limit: 100\n};\n\nreturn [{ json: { balancesLoaded: Object.keys(balanceMap).length, searchPayload } }];"
      },
      "id": "55a878af-b46f-40fe-b0d9-2e10fa103ecd",
      "name": "Store Calendar & Balance Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2944,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst customers = store.currentChunkCustomers || [];\nconst odataFilter = customers\n  .map(c => `No eq '${String(c.number).replace(/'/g, \"''\")}'`)\n  .join(' or ');\nreturn [{ json: { odataFilter } }];"
      },
