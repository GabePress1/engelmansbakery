    {
      "parameters": {
        "jsCode": "const customers = $input.first().json.value || [];\nif (customers.length === 0) return [{ json: { skipped: true, count: 0 } }];\nreturn customers.map(c => ({ json: c }));"
      },
      "id": "3dbe34cf-c1cf-487d-8b1e-a0587224227e",
      "name": "Expand Customers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const customers = $input.all().map(i => i.json);\nif (customers[0]?.skipped) return $input.all();\n\nconst chunkSize = 100;\nconst chunks = [];\nfor (let i = 0; i < customers.length; i += chunkSize) {\n  const slice = customers.slice(i, i + chunkSize);\n  chunks.push({ json: {\n    chunkCustomers: slice,\n    searchPayload: {\n      filterGroups: [{ filters: [{ propertyName: 'erp_account_number', operator: 'IN', values: slice.map(c => String(c.number)) }] }],\n      properties: ['hs_object_id', 'name', 'erp_account_number', 'relationship', 'division_multiselect'],\n      limit: 100\n    }\n  }});\n}\nreturn chunks;"
      },
