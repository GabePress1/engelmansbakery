{
  "name": "Phase 2 – BC → HubSpot Contacts (Excel-gated)",
  "nodes": [
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "30 6 * * 1-5" }]
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Read Last Timestamp",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [220, 300],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "getRows",
        "workbookRRID": "={{ $vars.EXCEL_WORKBOOK_ID }}",
        "worksheetId": "sync_log",
        "returnAll": true,
        "options": { "dataStartRow": 2 }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Set Timestamp Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst phase2Rows = rows.filter(r => r.json.phase === 'phase2');\nphase2Rows.sort((a, b) => new Date(b.json.run_date) - new Date(a.json.run_date));\n\nconst lastTs = phase2Rows.length > 0\n  ? phase2Rows[0].json.last_bc_timestamp\n  : '2000-01-01T00:00:00Z';\n\nreturn [{ json: { lastTimestamp: lastTs, runDate: new Date().toISOString() } }];"
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Fetch Changed BC Contacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [660, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.BC_BASE_URL }}/companies({{ $vars.BC_COMPANY_ID }})/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/json" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "$filter", "value": "={{ `lastModifiedDateTime gt ${$json.lastTimestamp} and type eq 'Person'` }}" },
            { "name": "$select", "value": "id,number,displayName,email,phoneNumber,companyNumber,jobTitle,lastModifiedDateTime" },
            { "name": "$top", "value": "500" }
          ]
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "Any Contacts Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.value.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "Split Into Contacts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1100, 200],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000007",
      "name": "Read HubSpot ID Cache",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [1320, 200],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "getRows",
        "workbookRRID": "={{ $vars.EXCEL_WORKBOOK_ID }}",
        "worksheetId": "hubspot_id_cache",
        "returnAll": true,
        "options": { "dataStartRow": 2 }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000008",
      "name": "Resolve Company HubSpot ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 200],
      "parameters": {
        "jsCode": "const contact = $('Split Into Contacts').first().json;\nconst cacheRows = $input.all();\n\n// Find the parent company's HubSpot ID using companyNumber\nconst companyMatch = cacheRows.find(r =>\n  String(r.json.erp_account_number) === String(contact.companyNumber)\n);\n\n// Find if this contact already has a HubSpot ID stored\nconst contactKey = `contact_${contact.number}`;\nconst contactMatch = cacheRows.find(r =>\n  String(r.json.erp_account_number) === contactKey\n);\n\nreturn [{\n  json: {\n    ...contact,\n    parentHubspotCompanyId: companyMatch ? companyMatch.json.hubspot_id : null,\n    hubspotContactId: contactMatch ? contactMatch.json.hubspot_id : null,\n    cacheKey: contactKey,\n    isNew: !contactMatch\n  }\n}];"
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000009",
      "name": "New or Existing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, 200],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond2",
              "leftValue": "={{ $json.isNew }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equal" }
            }
          ]
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000010",
      "name": "Create HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [1980, 100],
      "credentials": { "hubspotApi": { "name": "HubSpot - Engelmans" } },
      "parameters": {
        "resource": "contact",
        "operation": "create",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "firstName": "={{ $json.displayName.split(' ')[0] }}",
          "lastName": "={{ $json.displayName.split(' ').slice(1).join(' ') }}",
          "phone": "={{ $json.phoneNumber }}",
          "jobtitle": "={{ $json.jobTitle }}",
          "associatedCompanyId": "={{ $json.parentHubspotCompanyId }}"
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000011",
      "name": "Update HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [1980, 320],
      "credentials": { "hubspotApi": { "name": "HubSpot - Engelmans" } },
      "parameters": {
        "resource": "contact",
        "operation": "update",
        "contactId": "={{ $json.hubspotContactId }}",
        "updateFields": {
          "firstName": "={{ $json.displayName.split(' ')[0] }}",
          "lastName": "={{ $json.displayName.split(' ').slice(1).join(' ') }}",
          "phone": "={{ $json.phoneNumber }}",
          "jobtitle": "={{ $json.jobTitle }}"
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000012",
      "name": "Write New Contact ID to Cache",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [2200, 100],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "appendOrUpdate",
        "workbookRRID": "={{ $vars.EXCEL_WORKBOOK_ID }}",
        "worksheetId": "hubspot_id_cache",
        "keyRow": 1,
        "dataStartRow": 2,
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "erp_account_number": "={{ $('Resolve Company HubSpot ID').first().json.cacheKey }}",
            "hubspot_id": "={{ $json.id }}"
          }
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000013",
      "name": "Merge Create + Update",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2420, 200],
      "parameters": { "mode": "passThrough", "output": "input1" }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000014",
      "name": "Track Max Timestamp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 200],
      "parameters": {
        "jsCode": "const current = $input.first().json.lastModifiedDateTime || '';\nconst stored = $vars.RUNNING_MAX_TS_P2 || '';\n$vars.RUNNING_MAX_TS_P2 = current > stored ? current : stored;\nreturn $input.all();"
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000015",
      "name": "Write Sync Log",
      "type": "n8n-nodes-base.microsoftExcel",
      "typeVersion": 2,
      "position": [1100, 460],
      "credentials": { "microsoftExcelOAuth2Api": { "name": "Microsoft 365 - Engelmans" } },
      "parameters": {
        "operation": "append",
        "workbookRRID": "={{ $vars.EXCEL_WORKBOOK_ID }}",
        "worksheetId": "sync_log",
        "keyRow": 1,
        "dataStartRow": 2,
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_date": "={{ $('Set Timestamp Window').first().json.runDate }}",
            "phase": "phase2",
            "records_processed": "={{ $('Fetch Changed BC Contacts').first().json.value.length }}",
            "last_bc_timestamp": "={{ $vars.RUNNING_MAX_TS_P2 || $('Set Timestamp Window').first().json.lastTimestamp }}"
          }
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Read Last Timestamp", "type": "main", "index": 0 }]] },
    "Read Last Timestamp": { "main": [[{ "node": "Set Timestamp Window", "type": "main", "index": 0 }]] },
    "Set Timestamp Window": { "main": [[{ "node": "Fetch Changed BC Contacts", "type": "main", "index": 0 }]] },
    "Fetch Changed BC Contacts": { "main": [[{ "node": "Any Contacts Changed?", "type": "main", "index": 0 }]] },
    "Any Contacts Changed?": {
      "main": [
        [{ "node": "Split Into Contacts", "type": "main", "index": 0 }],
        [{ "node": "Write Sync Log", "type": "main", "index": 0 }]
      ]
    },
    "Split Into Contacts": { "main": [[{ "node": "Read HubSpot ID Cache", "type": "main", "index": 0 }]] },
    "Read HubSpot ID Cache": { "main": [[{ "node": "Resolve Company HubSpot ID", "type": "main", "index": 0 }]] },
    "Resolve Company HubSpot ID": { "main": [[{ "node": "New or Existing?", "type": "main", "index": 0 }]] },
    "New or Existing?": {
      "main": [
        [{ "node": "Create HubSpot Contact", "type": "main", "index": 0 }],
        [{ "node": "Update HubSpot Contact", "type": "main", "index": 0 }]
      ]
    },
    "Create HubSpot Contact": { "main": [[{ "node": "Write New Contact ID to Cache", "type": "main", "index": 0 }]] },
    "Write New Contact ID to Cache": { "main": [[{ "node": "Merge Create + Update", "type": "main", "index": 0 }]] },
    "Update HubSpot Contact": { "main": [[{ "node": "Merge Create + Update", "type": "main", "index": 1 }]] },
    "Merge Create + Update": { "main": [[{ "node": "Track Max Timestamp", "type": "main", "index": 0 }]] },
    "Track Max Timestamp": { "main": [[{ "node": "Split Into Contacts", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
