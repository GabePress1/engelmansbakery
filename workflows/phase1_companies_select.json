    {
      "id": "0c0ff01b-693c-41ce-a927-fadc7b73cdda",
      "name": "Parse ERP List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $('ERP Numbers').first().json.erp_numbers || '';\nconst erpList = raw.split(',').map(e => e.trim()).filter(e => e.length > 0);\nif (erpList.length === 0) throw new Error('No ERP numbers provided in the ERP Numbers node');\nconst bcFilter = erpList.map(e => `number eq '${e.replace(/'/g, \"''\")}'`).join(' or ');\nreturn [{ json: { erpList, bcFilter } }];"
      }
    },
    {
      "parameters": {
        "url": "=https://api.businesscentral.dynamics.com/v2.0/{{ $('Keys').first().json.Tenant_ID }}/production/api/v2.0/companies({{ $('Keys').first().json.Company_ID }})/customers",
        "sendQuery": true,
