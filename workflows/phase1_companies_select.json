      ],
      "parameters": {
        "jsCode": "const customers = $input.first().json.value || [];\nconst store = $getWorkflowStaticData('global');\nconst customerMap = {};\nfor (const c of customers) {\n  if (c.number) customerMap[String(c.number)] = c;\n}\nstore.customerMap = customerMap;\nreturn [{ json: { bcCustomerCount: customers.length } }];"
