    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst totalProcessed = (store.hsCompanies || []).length;\nstore.hsCompanies = [];\nstore.hsCursor = null;\nstore.customerMap = {};\nstore.balanceMap = {};\nstore.currentBatch = [];\nreturn [{ json: { message: 'Phase 1 v1.3 complete', totalProcessed } }];"
      },
      "id": "c27ddf67-369c-4fef-ae7a-c6540049255e",
      "name": "Sync Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
