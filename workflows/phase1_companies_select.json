        2464,
        0
      ],
      "parameters": {
        "jsCode": "const results = $input.first().json.results || [];\nif (results.length === 0) return [{ json: { skipped: true, count: 0 } }];\nconst store = $getWorkflowStaticData('global');\nstore.hsCompanies = results;\nreturn results.map(c => ({ json: c }));"
      }
