      "id": "0762cfea-a5c9-4368-a33a-269af46059b8",
      "name": "Initialize HS Fetch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst payload = {\n  filterGroups: [{\n    filters: [\n      { propertyName: 'relationship',         operator: 'EQ',             value: 'Customer' },\n      { propertyName: 'division_multiselect',  operator: 'CONTAINS_TOKEN', value: \"Engelman's Bakery\" },\n      { propertyName: 'erp_account_number',    operator: 'HAS_PROPERTY' }\n    ]\n  }],\n  properties: ['erp_account_number'],\n  limit: 200\n};\nif (store.hsCursor) payload.after = store.hsCursor;\nreturn [{ json: payload }];"
      },
      "id": "8597c626-043f-4158-a59a-2d31c264e2f4",
      "name": "Build HS Search Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        -48
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/companies/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "e9f6bf3f-102a-4be0-b345-46507bf02c4d",
      "name": "Search HubSpot Companies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2240,
        -48
      ],
      "credentials": {
        "hubspotAppToken": {
          "id": "vxGS6a3iorMrt7wb",
          "name": "HubSpot Service Key Production"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst results = response.results || [];\nconst store = $getWorkflowStaticData('global');\nif (!store.hsCompanies) store.hsCompanies = [];\n// Store only id + erp_account_number to keep static data small\nstore.hsCompanies.push(...results.map(c => ({\n  id: c.id,\n  properties: { erp_account_number: c.properties?.erp_account_number }\n})));\nconst nextCursor = response.paging?.next?.after;\nstore.hsCursor = (nextCursor && results.length > 0) ? nextCursor : null;\nconst hasMore = store.hsCursor !== null ? 1 : 0;\nreturn [{ json: { fetched: store.hsCompanies.length, thisPage: results.length, hasMore } }];"
      },
      "id": "5342e5ff-e149-44db-8099-ffaf3a6718b2",
      "name": "Accumulate HS Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        -48
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.hasMore }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "afcdb4c8-d035-4282-9b3c-5eee15b11b33",
      "name": "More HS Pages?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2688,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst companies = store.hsCompanies || [];\nif (companies.length === 0) return [{ json: { skipped: true, count: 0 } }];\nreturn companies.map(c => ({ json: c }));"
      },
      "id": "211ad271-34c9-4be5-9f73-b939b3a356bd",
