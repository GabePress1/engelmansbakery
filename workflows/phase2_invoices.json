            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Fetch All BC Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch All BC Invoices": {
      "main": [
        [
