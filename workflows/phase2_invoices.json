            }
          ]
        }
      },
      "id": "p2-0001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "ebe40ae7-9328-4c95-a27b-5b687f75ab5f",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "p2-0002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        224,
        100
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.BC_BASE_URL }}/companies({{ $('Config').first().json.BC_COMPANY_ID }})/salesInvoices",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$select",
              "value": "id,number,customerNumber,customerName,invoiceDate,dueDate,amountIncludingTax,status,lastModifiedDateTime"
            },
            {
              "name": "$top",
              "value": "5000"
            },
            {
              "name": "$orderby",
              "value": "invoiceDate asc"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "p2-0005",
      "name": "Fetch All BC Invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        448,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const invoices = $input.first().json.value || [];\nreturn invoices.map(i => ({ json: i }));"
      },
      "id": "p2-0006",
      "name": "Expand Invoices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        100
      ]
    },
    {
      "id": "9b254e0b-0ec5-4e64-9115-f060ddf19d09",
      "name": "Group First & Last 10",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        100
      ],
      "parameters": {
        "jsCode": "const invoices = $input.all().map(i => i.json);\n// Invoices arrive sorted oldest \u2192 newest from BC\nconst byCustomer = {};\nfor (const inv of invoices) {\n  const cust = String(inv.customerNumber || 'UNKNOWN');\n  if (!byCustomer[cust]) byCustomer[cust] = [];\n  byCustomer[cust].push(inv);\n}\nconst result = [];\nconst seen = new Set();\nfor (const invList of Object.values(byCustomer)) {\n  const first1 = invList.slice(0, 1);\n  const last10 = invList.slice(-10);\n  for (const inv of [...first1, ...last10]) {\n    if (!seen.has(inv.number)) {\n      seen.add(inv.number);\n      result.push({ json: inv });\n    }\n  }\n}\nreturn result;"
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When clicking 'Execute workflow'": {
