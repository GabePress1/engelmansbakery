            "node": "Expand Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Expand Invoices": {
      "main": [
        [
          {
            "node": "Group First & Last 10",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
