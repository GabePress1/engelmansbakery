    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst phase2 = rows\n  .filter(r => r.json.phase === 'phase2')\n  .sort((a, b) => new Date(b.json.run_date) - new Date(a.json.run_date));\nconst lastTimestamp = phase2.length > 0 ? phase2[0].json.last_bc_timestamp : '2000-01-01T00:00:00Z';\nreturn [{ json: { lastTimestamp, runDate: new Date().toISOString() } }];"
      },
      "id": "p2-0004",
      "name": "Set Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        304
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.BC_BASE_URL }}/companies({{ $('Config').first().json.BC_COMPANY_ID }})/salesInvoices",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$select",
              "value": "id,number,customerNumber,customerName,invoiceDate,dueDate,amountIncludingTax,status,lastModifiedDateTime"
            },
