        880,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const invoices = $input.first().json.value || [];\nreturn invoices.map(i => ({ json: i }));"
      },
      "id": "p2-0006",
      "name": "Expand Invoices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        304
      ]
    },
    {
      "id": "e23fc5b7-8790-4eb4-9627-a286f6d081d0",
      "name": "Group First & Last 10",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1216,
        304
      ],
      "parameters": {
        "jsCode": "const invoices = $input.all().map(i => i.json);\n// Invoices arrive sorted asc by invoiceDate from BC\nconst byCustomer = {};\nfor (const inv of invoices) {\n  const cust = String(inv.customerNumber || 'UNKNOWN');\n  if (!byCustomer[cust]) byCustomer[cust] = [];\n  byCustomer[cust].push(inv);\n}\nconst result = [];\nconst seen = new Set();\nfor (const invList of Object.values(byCustomer)) {\n  const first1  = invList.slice(0, 1);\n  const last10  = invList.slice(-10);\n  for (const inv of [...first1, ...last10]) {\n    if (!seen.has(inv.number)) {\n      seen.add(inv.number);\n      result.push({ json: inv });\n    }\n  }\n}\nreturn result;"
      }
    },
    {
      "parameters": {
        "options": {}
      },
